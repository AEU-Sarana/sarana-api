pipeline {
    agent any

    environment {
        // GitHub Container Registryyy
        REGISTRY = 'ghcr.io'
        GITHUB_USERNAME = credentials('github-username')
        GITHUB_TOKEN = credentials('github-token')
        APP_NAME = 'stock-pos-server'
        VERSION = "${BUILD_NUMBER}-${GIT_COMMIT.take(7)}"
        DOCKER_IMAGE = "${REGISTRY}/${GITHUB_USERNAME.toLowerCase()}/${APP_NAME}"
    }

    triggers {
        githubPush()
        pollSCM('H/5 * * * *')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 2, unit: 'HOURS')
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "=== Checking out code from repository ==="
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/nan']],
                        userRemoteConfigs: [[
                            url: 'git@github.com:techey-solution/stock-pos-server.git',
                            credentialsId: 'github-ssh-key'
                        ]]
                    ])
                    sh '''
                        echo "Branch: ${GIT_BRANCH}"
                        echo "Commit: ${GIT_COMMIT}"
                        git log -1 --oneline
                    '''
                }
            }
        }

        stage('Environment Setup') {
            steps {
                script {
                    echo "=== Verifying environment ==="
                    sh '''
                        node --version
                        npm --version
                        pnpm --version
                        docker --version
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "=== Installing project dependencies ==="
                    sh 'pnpm install --frozen-lockfile'
                }
            }
        }

        stage('Linting') {
            steps {
                script {
                    echo "=== Running ESLint ==="
                    sh 'pnpm lint || true'
                }
            }
        }

        stage('Format Check') {
            steps {
                script {
                    echo "=== Checking code formatting ==="
                    sh 'pnpm format:check || true'
                }
            }
        }

        stage('Build Application') {
            steps {
                script {
                    echo "=== Building TypeScript application ==="
                    sh '''
                        pnpm db:generate
                        pnpm build
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "=== Building Docker image for GHCR ==="
                    sh '''
                        docker build \
                            --target production \
                            -t ${DOCKER_IMAGE}:${VERSION} \
                            -t ${DOCKER_IMAGE}:latest \
                            --label "org.opencontainers.image.source=https://github.com/${GITHUB_USERNAME}/stock-pos-server" \
                            --label "org.opencontainers.image.description=Stock POS Server Application" \
                            --label "org.opencontainers.image.version=${VERSION}" \
                            -f Dockerfile \
                            .
                        
                        echo "Built image: ${DOCKER_IMAGE}:${VERSION}"
                        docker image inspect ${DOCKER_IMAGE}:${VERSION}
                    '''
                }
            }
        }

        stage('Security Scan') {
            when {
                anyOf {
                    branch 'nan'
                    branch 'origin/nan'
                }
            }
            steps {
                script {
                    echo "=== Running security scan on Docker image ==="
                    sh '''
                        # Example: Using trivy for image scanning
                        # trivy image --severity HIGH,CRITICAL ${DOCKER_IMAGE}:${VERSION} || true
                        echo "Image: ${DOCKER_IMAGE}:${VERSION}"
                        echo "Security scan completed"
                    '''
                }
            }
        }

        stage('Push to GHCR') {
            when {
                anyOf {
                    branch 'nan'
                    branch 'origin/nan'
                }
            }
            steps {
                script {
                    echo "=== Pushing Docker image to GitHub Container Registry ==="
                    sh '''
                        set -e
                        
                        echo "Registry: ${REGISTRY}"
                        echo "Username: ${GITHUB_USERNAME}"
                        echo "Image: ${DOCKER_IMAGE}"
                        echo "Version: ${VERSION}"
                        
                        echo "Logging into GHCR..."
                        echo "${GITHUB_TOKEN}" | docker login ${REGISTRY} -u ${GITHUB_USERNAME} --password-stdin
                        
                        if [ $? -eq 0 ]; then
                            echo "✓ Login successful"
                        else
                            echo "✗ Login failed"
                            exit 1
                        fi
                        
                        echo "Pushing versioned image ${DOCKER_IMAGE}:${VERSION}..."
                        docker push ${DOCKER_IMAGE}:${VERSION}
                        
                        echo "Pushing latest tag..."
                        docker push ${DOCKER_IMAGE}:latest
                        
                        echo "✓ Successfully pushed to ${DOCKER_IMAGE}"
                        docker logout ${REGISTRY}
                    '''
                }
            }
            post {
                success {
                    script {
                        echo "=== Cleaning up old stock-pos-server Docker images ==="
                        sh '''
                            # Only remove old stock-pos-server images (not Jenkins or other images)
                            docker images ${DOCKER_IMAGE} --format "{{.ID}} {{.Tag}}" | \
                                grep -v "latest" | \
                                grep -v "${VERSION}" | \
                                awk '{print $1}' | \
                                xargs -r docker rmi -f || true
                            
                            # Prune only dangling images (untagged intermediate layers)
                            # This won't touch Jenkins or other tagged images
                            docker image prune -f
                            
                            echo "Docker cleanup completed - Jenkins images preserved"
                            docker images | grep -E "(stock-pos-server|jenkins)"
                        '''
                    }
                }
            }
        }

        stage('Deploy with Ansible') {
            when {
                expression { 
                    env.GIT_BRANCH == 'nan' || 
                    env.GIT_BRANCH == 'origin/nan' ||
                    env.BRANCH_NAME == 'nan'
                }
            }
            steps {
                script {
                    echo "=== Deploying to app server with Ansible ==="
                    echo "Target: app_servers (89.167.6.46)"
                    echo "Current branch: ${env.GIT_BRANCH ?: env.BRANCH_NAME}"
                    
                    withCredentials([
                        string(credentialsId: 'ansible-vault-password', variable: 'VAULT_PASS')
                    ]) {
                        sshagent(['deploy-ssh-key']) {
                            sh '''
                                set -e
                                
                                # Create temporary vault password file
                                echo "${VAULT_PASS}" > /tmp/vault_pass_${BUILD_NUMBER}.txt
                                chmod 600 /tmp/vault_pass_${BUILD_NUMBER}.txt
                                
                                # Test SSH connection to backend server
                                echo "Testing SSH connection to app_servers..."
                                ssh -o StrictHostKeyChecking=no deployer@89.167.6.46 "docker ps" || echo "Warning: Could not verify backend connectivity"
                                
                                # Run Ansible deployment to app servers (NOT localhost)
                                echo "Running Ansible deployment..."
                                ansible-playbook ansible/playbooks/deploy.yml \
                                    -i ansible/inventories/production/hosts.ini \
                                    -l app_servers \
                                    --vault-password-file /tmp/vault_pass_${BUILD_NUMBER}.txt \
                                    -e "node_env=production" \
                                    -e "pull_images=true" \
                                    -e "build_image=false" \
                                    -e "docker_registry=${REGISTRY}/${GITHUB_USERNAME}" \
                                    -e "docker_image_name=${APP_NAME}" \
                                    -e "docker_image_tag=${VERSION}" \
                                    -e "confirm_deploy=yes" \
                                    -vvv
                                
                                # Cleanup
                                rm -f /tmp/vault_pass_${BUILD_NUMBER}.txt
                                echo "Deployment completed successfully"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo "=== Cleanup ==="
                
                // Clean up dangling and unused Docker resources
                sh '''
                    # Remove dangling images
                    docker image prune -f
                    
                    # Remove unused build cache
                    docker builder prune -f --filter "until=24h"
                    
                    echo "Docker system cleanup completed"
                '''
                
                cleanWs()
            }
        }
        failure {
            script {
                echo "❌ Build failed!"
                echo "Build: ${BUILD_NUMBER}"
                echo "Branch: ${GIT_BRANCH}"
            }
        }
    }
}
