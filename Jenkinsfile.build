def notifyTelegram(String message) {
    try {
        withCredentials([
            string(credentialsId: 'telegram-bot-token', variable: 'TG_BOT_TOKEN'),
            string(credentialsId: 'telegram-chat-id', variable: 'TG_CHAT_ID')
        ]) {
            withEnv(["TELEGRAM_MESSAGE=${message}"]) {
                sh '''#!/bin/sh
                    curl -s -X POST "https://api.telegram.org/bot$TG_BOT_TOKEN/sendMessage" \
                        --data-urlencode "chat_id=$TG_CHAT_ID" \
                        --data-urlencode "text=$TELEGRAM_MESSAGE" \
                        --data-urlencode "parse_mode=HTML" > /dev/null || true
                '''
            }
        }
    } catch (Exception e) {
        echo "Telegram notification skipped: missing/invalid Jenkins credentials (telegram-bot-token, telegram-chat-id)."
    }
}

pipeline {
    agent any

    environment {
        // GitHub Container Registryy
        REGISTRY = 'ghcr.io'
        REPO_OWNER = 'techey-solution'
        GITHUB_USERNAME = credentials('github-username')
        GITHUB_TOKEN = credentials('ghcr-classic')
        APP_NAME = 'stock-pos-server'
        GHCR_NAMESPACE = "${REPO_OWNER.toLowerCase()}"
        DOCKER_IMAGE = "${REGISTRY}/${GHCR_NAMESPACE}/${APP_NAME}"
    }

    triggers {
        githubPush()
    }

    options {
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 2, unit: 'HOURS')
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "=== Checking out code from repository ==="
                    // Ensure stale workspace content is removed before checkout
                    deleteDir()
                    notifyTelegram("🔨 <b>Build started</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>")
                    // Respect branch configured in Jenkins job/SCM
                    def scmVars = checkout(scm)
                    env.GIT_BRANCH = scmVars?.GIT_BRANCH ?: sh(script: "git rev-parse --abbrev-ref HEAD", returnStdout: true).trim()
                    env.GIT_COMMIT = scmVars?.GIT_COMMIT ?: sh(script: "git rev-parse HEAD", returnStdout: true).trim()
                    env.SHORT_COMMIT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    env.VERSION = sh(script: 'echo "${BUILD_NUMBER}-$(git rev-parse --short HEAD)"', returnStdout: true).trim()
                    sh '''
                        echo "Branch: ${GIT_BRANCH}"
                        echo "Commit: ${GIT_COMMIT}"
                        echo "Version: ${VERSION}"
                        git log -1 --oneline
                    '''
                }
            }
        }

        stage('Environment Setup') {
            steps {
                script {
                    echo "=== Verifying environment ==="
                    sh '''
                        node --version
                        npm --version
                        pnpm --version
                        docker --version
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "=== Installing project dependencies ==="
                    sh 'pnpm install --frozen-lockfile'
                }
            }
        }

        stage('Linting') {
            steps {
                script {
                    echo "=== Running ESLint ==="
                    sh 'pnpm lint || true'
                }
            }
        }

        stage('Format Check') {
            steps {
                script {
                    echo "=== Checking code formatting ==="
                    sh 'pnpm format:check || true'
                }
            }
        }

        stage('Build Application') {
            steps {
                script {
                    echo "=== Building TypeScript application ==="
                    sh '''
                        pnpm db:generate
                        pnpm build
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "=== Building Docker image for GHCR ==="
                    if (!env.VERSION?.trim()) {
                        env.VERSION = sh(script: 'echo "${BUILD_NUMBER}-$(git rev-parse --short HEAD)"', returnStdout: true).trim()
                    }
                    if (!env.VERSION?.trim()) {
                        error("VERSION is empty; cannot build Docker image tag.")
                    }
                    echo "Docker tag version: ${env.VERSION}"
                    sh '''
                        docker build \
                            --target production \
                            -t ${DOCKER_IMAGE}:${VERSION} \
                            -t ${DOCKER_IMAGE}:latest \
                            --label "org.opencontainers.image.source=https://github.com/${REPO_OWNER}/${APP_NAME}" \
                            --label "org.opencontainers.image.description=Stock POS Server Application" \
                            --label "org.opencontainers.image.version=${VERSION}" \
                            -f Dockerfile \
                            .
                        
                        echo "Built image: ${DOCKER_IMAGE}:${VERSION}"
                        docker image inspect --format "Image ID: {{.Id}} | Size: {{.Size}} | Created: {{.Created}}" ${DOCKER_IMAGE}:${VERSION}
                    '''
                }
            }
        }

        stage('Security Scan') {
            when {
                anyOf {
                    branch 'main'
                    branch 'origin/main'
                    branch 'nan'
                    branch 'origin/nan'
                }
            }
            steps {
                script {
                    echo "=== Running security scan on Docker image ==="
                    sh '''
                        # Example: Using trivy for image scanning
                        # trivy image --severity HIGH,CRITICAL ${DOCKER_IMAGE}:${VERSION} || true
                        echo "Image: ${DOCKER_IMAGE}:${VERSION}"
                        echo "Security scan completed"
                    '''
                }
            }
        }

        stage('Push to GHCR') {
            steps {
                script {
                    echo "=== Pushing Docker image to GitHub Container Registry ==="
                    echo "Branch: ${env.GIT_BRANCH ?: env.BRANCH_NAME}"
                    
                    withCredentials([
                        string(credentialsId: 'ghcr-classic', variable: 'GHCR_TOKEN')
                    ]) {
                        sh '''#!/bin/bash
                            set -euo pipefail

                            auth_hint() {
                                echo "ERROR: Invalid or insufficient GHCR credential (ghcr-classic)."
                                echo "Required: write:packages, read:packages, and org SSO authorization if enabled."
                            }

                            push_tag() {
                                local tag="$1"
                                echo "Pushing ${DOCKER_IMAGE}:${tag}"
                                if ! docker push "${DOCKER_IMAGE}:${tag}"; then
                                    echo "ERROR: Push failed for ${DOCKER_IMAGE}:${tag}"
                                    auth_hint
                                    docker logout ${REGISTRY} >/dev/null 2>&1 || true
                                    exit 1
                                fi
                            }

                            echo "GHCR push"
                            echo "Image: ${DOCKER_IMAGE}:${VERSION}"
                            echo "Actor: ${GITHUB_USERNAME}"

                            if ! echo "${GHCR_TOKEN}" | docker login ${REGISTRY} -u ${GITHUB_USERNAME} --password-stdin >/dev/null 2>&1; then
                                auth_hint
                                exit 1
                            fi
                            echo "GHCR login successful"

                            GHCR_CHECK_STATUS=$(curl -sS -o /tmp/ghcr_preflight.json -w "%{http_code}" \
                                -H "Authorization: Bearer ${GHCR_TOKEN}" \
                                "https://${REGISTRY}/v2/${GHCR_NAMESPACE}/${APP_NAME}/tags/list" || true)

                            if [ "${GHCR_CHECK_STATUS}" = "200" ] || [ "${GHCR_CHECK_STATUS}" = "404" ]; then
                                echo "GHCR preflight: HTTP ${GHCR_CHECK_STATUS}"
                            elif [ "${GHCR_CHECK_STATUS}" = "401" ] || [ "${GHCR_CHECK_STATUS}" = "403" ]; then
                                echo "WARNING: GHCR preflight HTTP ${GHCR_CHECK_STATUS} for ${DOCKER_IMAGE}"
                                auth_hint
                                echo "Continuing to push for confirmation..."
                            else
                                echo "WARNING: GHCR preflight unexpected HTTP ${GHCR_CHECK_STATUS}; continuing."
                            fi

                            push_tag "${VERSION}"
                            push_tag "latest"

                            if ! docker pull ${DOCKER_IMAGE}:${VERSION} >/dev/null 2>&1; then
                                echo "ERROR: Push verification failed for ${DOCKER_IMAGE}:${VERSION}"
                                auth_hint
                                docker logout ${REGISTRY} >/dev/null 2>&1 || true
                                exit 1
                            fi

                            docker logout ${REGISTRY} >/dev/null 2>&1 || true
                            echo "Push completed: ${DOCKER_IMAGE}:${VERSION} and latest"
                        '''
                    }
                }
            }
            post {
                success {
                    script {
                        echo "=== Cleaning up old stock-pos-server Docker images ==="
                        sh '''
                            # Only remove old stock-pos-server images (not Jenkins or other images)
                            docker images ${DOCKER_IMAGE} --format "{{.ID}} {{.Tag}}" | \
                                grep -v "latest" | \
                                grep -v "${VERSION}" | \
                                awk '{print $1}' | \
                                xargs -r docker rmi -f || true
                            
                            # Prune only dangling images (untagged intermediate layers)
                            # This won't touch Jenkins or other tagged images
                            docker image prune -f
                            
                            echo "Docker cleanup completed - Jenkins images preserved"
                            docker images | grep -E "(stock-pos-server|jenkins)"
                        '''
                    }
                }
            }
        }

        stage('Capture Current Release') {
            when {
                expression {
                    env.GIT_BRANCH == 'main' ||
                    env.GIT_BRANCH == 'origin/main' ||
                    env.GIT_BRANCH == 'nan' ||
                    env.GIT_BRANCH == 'origin/nan' ||
                    env.BRANCH_NAME == 'main' ||
                    env.BRANCH_NAME == 'nan'
                }
            }
            steps {
                script {
                    echo "=== Capturing current release tag on target server ==="
                    def previousImage = ''
                    sshagent(['deploy-ssh-key']) {
                        previousImage = sh(
                            script: '''#!/bin/bash
                                ssh -o StrictHostKeyChecking=no deployer@89.167.6.46 \
                                  'set -e
                                   ACTIVE_COLOR="$(cat /opt/stock-pos/.active_color 2>/dev/null || echo blue)"
                                   if [ "$ACTIVE_COLOR" != "blue" ] && [ "$ACTIVE_COLOR" != "green" ]; then
                                     ACTIVE_COLOR="blue"
                                   fi
                                   docker inspect --format="{{.Config.Image}}" "stock-pos-app-${ACTIVE_COLOR}" 2>/dev/null || \
                                   docker inspect --format="{{.Config.Image}}" stock-pos-app 2>/dev/null || true'
                            ''',
                            returnStdout: true
                        ).trim()
                    }

                    if (previousImage) {
                        env.PREVIOUS_TAG = previousImage.tokenize(':')[-1]
                    } else {
                        env.PREVIOUS_TAG = 'unknown'
                    }
                    echo "Previous running tag: ${env.PREVIOUS_TAG}"
                }
            }
        }

        stage('Deploy with Ansible') {
            when {
                expression { 
                    env.GIT_BRANCH == 'main' || 
                    env.GIT_BRANCH == 'origin/main' ||
                    env.GIT_BRANCH == 'nan' ||
                    env.GIT_BRANCH == 'origin/nan' ||
                    env.BRANCH_NAME == 'main' ||
                    env.BRANCH_NAME == 'nan'
                }
            }
            steps {
                script {
                    echo "=== Deploying to app server with Ansible ==="
                    echo "Target: app_servers (89.167.6.46)"
                    echo "Current branch: ${env.GIT_BRANCH ?: env.BRANCH_NAME}"
                    notifyTelegram("🚀 <b>Deploy started</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Env:</b> production\n• <b>Branch:</b> ${env.GIT_BRANCH ?: env.BRANCH_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Version:</b> ${VERSION}\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>")
                    
                    withCredentials([
                        string(credentialsId: 'ansible-vault-password', variable: 'VAULT_PASS')
                    ]) {
                        sshagent(['deploy-ssh-key']) {
                            sh '''
                                set -e

                                echo "=== Verify checked out deploy-compose.yml ==="
                                git rev-parse --short HEAD
                                git log -1 --oneline
                                nl -ba ansible/roles/app-deploy/tasks/deploy-compose.yml | sed -n '58,75p'
                                if rg -n "\\{% if \\(storage_provider \\| default\\('minio'\\) \\| lower\\) == 'minio' %\\}" ansible/roles/app-deploy/tasks/deploy-compose.yml >/dev/null; then
                                    echo "ERROR: Stale deploy-compose.yml detected in Jenkins workspace (old Jinja control block still present)."
                                    exit 1
                                fi
                                
                                # Validate vault password credential
                                if [ -z "${VAULT_PASS}" ]; then
                                    echo "ERROR: VAULT_PASS is empty! Check Jenkins credential 'ansible-vault-password'"
                                    exit 1
                                fi
                                
                                # Create temporary vault password file
                                printf '%s' "${VAULT_PASS}" > /tmp/vault_pass_${BUILD_NUMBER}.txt
                                chmod 600 /tmp/vault_pass_${BUILD_NUMBER}.txt
                                
                                # Run Ansible deployment to app servers
                                echo "Running Ansible deployment..."
                                ansible-playbook ansible/playbooks/deploy.yml \
                                    -i ansible/inventories/production/hosts.ini \
                                    -l app_servers \
                                    --vault-password-file /tmp/vault_pass_${BUILD_NUMBER}.txt \
                                    -e "node_env=production" \
                                    -e "pull_images=true" \
                                    -e "build_image=false" \
                                    -e "run_db_migrations=true" \
                                    -e "run_db_seed=false" \
                                    -e "docker_registry=${REGISTRY}" \
                                    -e "docker_registry_username=${GITHUB_USERNAME}" \
                                    -e "docker_registry_password=${GITHUB_TOKEN}" \
                                    -e "docker_image_name=${APP_NAME}" \
                                    -e "docker_image_tag=${VERSION}" \
                                    -e "confirm_deploy=yes" \
                                    -vvv
                                
                                # Cleanup
                                rm -f /tmp/vault_pass_${BUILD_NUMBER}.txt
                                echo "Deployment completed successfully"
                            '''
                        }
                    }
                }
            }
            post {
                success {
                    script {
                        notifyTelegram("✅ <b>Deploy success</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Env:</b> production\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Version:</b> ${VERSION}\n• <b>URL:</b> https://familypos.techey.tech\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>")
                    }
                }
                failure {
                    script {
                        notifyTelegram("❌ <b>Deploy failed</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Env:</b> production\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Version:</b> ${VERSION}\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>\n• <b>Action:</b> Check console log")
                    }
                }
            }
        }

        stage('Post-Deploy Health Gate / Auto Rollback') {
            when {
                expression {
                    env.GIT_BRANCH == 'main' ||
                    env.GIT_BRANCH == 'origin/main' ||
                    env.GIT_BRANCH == 'nan' ||
                    env.GIT_BRANCH == 'origin/nan' ||
                    env.BRANCH_NAME == 'main' ||
                    env.BRANCH_NAME == 'nan'
                }
            }
            steps {
                script {
                    echo "=== Verifying deployment health on target server ==="
                    int healthRc = 1
                    sshagent(['deploy-ssh-key']) {
                        healthRc = sh(
                            script: '''#!/bin/bash
                                set +e
                                ssh -o StrictHostKeyChecking=no deployer@89.167.6.46 '
                                  ACTIVE_COLOR="$(cat /opt/stock-pos/.active_color 2>/dev/null || echo blue)"
                                  if [ "$ACTIVE_COLOR" = "green" ]; then
                                    APP_PORT=3002
                                  elif [ "$ACTIVE_COLOR" = "blue" ]; then
                                    APP_PORT=3001
                                  else
                                    APP_PORT=3000
                                  fi
                                  for i in $(seq 1 12); do
                                    curl -fsS "http://127.0.0.1:${APP_PORT}/api/health" >/dev/null && \
                                    curl -fsS http://127.0.0.1/api/health >/dev/null && exit 0
                                    sleep 10
                                  done
                                  exit 1
                                '
                            ''',
                            returnStatus: true
                        )
                    }

                    if (healthRc == 0) {
                        env.RELEASE_STATUS = 'success'
                        sh '''#!/bin/bash
                            echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) build=${BUILD_NUMBER} previous=${PREVIOUS_TAG:-unknown} new=${VERSION} status=${RELEASE_STATUS} url=${BUILD_URL}" >> release-history.log
                        '''
                        echo "Deployment health gate passed."
                        return
                    }

                    echo "Deployment health gate failed."
                    if (!env.PREVIOUS_TAG?.trim() || env.PREVIOUS_TAG == 'unknown') {
                        env.RELEASE_STATUS = 'rollback_skipped_no_previous_tag'
                        sh '''#!/bin/bash
                            echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) build=${BUILD_NUMBER} previous=${PREVIOUS_TAG:-unknown} new=${VERSION} status=${RELEASE_STATUS} url=${BUILD_URL}" >> release-history.log
                        '''
                        notifyTelegram("❌ <b>Deploy unhealthy</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Version:</b> ${VERSION}\n• <b>Rollback:</b> skipped (previous tag unknown)\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>")
                        error("Deployment failed health gate and rollback was skipped because previous tag is unknown.")
                    }

                    notifyTelegram("⚠️ <b>Deploy unhealthy</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Failed Version:</b> ${VERSION}\n• <b>Rolling back to:</b> ${env.PREVIOUS_TAG}")

                    int rollbackRc = 1
                    withCredentials([
                        string(credentialsId: 'ansible-vault-password', variable: 'VAULT_PASS')
                    ]) {
                        sshagent(['deploy-ssh-key']) {
                            rollbackRc = sh(
                                script: '''#!/bin/bash
                                    set +e
                                    printf '%s' "${VAULT_PASS}" > /tmp/vault_pass_${BUILD_NUMBER}.txt
                                    chmod 600 /tmp/vault_pass_${BUILD_NUMBER}.txt
                                    ansible-playbook ansible/playbooks/rollback.yml \
                                        -i ansible/inventories/production/hosts.ini \
                                        -l app_servers \
                                        --vault-password-file /tmp/vault_pass_${BUILD_NUMBER}.txt \
                                        -e "rollback_tag=${PREVIOUS_TAG}" \
                                        -e "confirm_rollback=yes"
                                    rc=$?
                                    rm -f /tmp/vault_pass_${BUILD_NUMBER}.txt
                                    exit $rc
                                ''',
                                returnStatus: true
                            )
                        }
                    }

                    if (rollbackRc == 0) {
                        env.RELEASE_STATUS = 'rolled_back'
                        sh '''#!/bin/bash
                            echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) build=${BUILD_NUMBER} previous=${PREVIOUS_TAG:-unknown} new=${VERSION} status=${RELEASE_STATUS} url=${BUILD_URL}" >> release-history.log
                        '''
                        notifyTelegram("⚠️ <b>Auto-rollback completed</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Failed Version:</b> ${VERSION}\n• <b>Rolled back to:</b> ${env.PREVIOUS_TAG}\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>")
                        error("Deployment failed health gate. Auto-rollback completed to ${env.PREVIOUS_TAG}.")
                    } else {
                        env.RELEASE_STATUS = 'rollback_failed'
                        sh '''#!/bin/bash
                            echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) build=${BUILD_NUMBER} previous=${PREVIOUS_TAG:-unknown} new=${VERSION} status=${RELEASE_STATUS} url=${BUILD_URL}" >> release-history.log
                        '''
                        notifyTelegram("🚨 <b>Auto-rollback failed</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Failed Version:</b> ${VERSION}\n• <b>Rollback target:</b> ${env.PREVIOUS_TAG}\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>")
                        error("Deployment failed health gate and auto-rollback failed.")
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                notifyTelegram("✅ <b>Build completed</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Version:</b> ${VERSION}\n• <b>Status:</b> Success")
            }
        }
        failure {
            script {
                echo "❌ Build failed!"
                echo "Build: ${BUILD_NUMBER}"
                echo "Branch: ${env.GIT_BRANCH ?: env.BRANCH_NAME}"
                notifyTelegram("❌ <b>Build failed</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Console Log</a>")
            }
        }
        always {
            script {
                echo "=== Cleanup ==="
                
                // Clean up dangling and unused Docker resources (only if node is available)
                try {
                    node {
                        sh '''
                            # Remove dangling images
                            docker image prune -f
                            
                            # Remove unused build cache
                            docker builder prune -f --filter "until=24h"
                            
                            echo "Docker system cleanup completed"
                        '''
                        
                        cleanWs()
                    }
                } catch (Exception e) {
                    echo "Cleanup skipped - node context not available: ${e.message}"
                }
            }
            archiveArtifacts artifacts: 'release-history.log', allowEmptyArchive: true
        }
    }
}
