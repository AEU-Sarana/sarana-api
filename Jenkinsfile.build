def notifyTelegram(String message) {
    try {
        withCredentials([
            string(credentialsId: 'telegram-bot-token', variable: 'TG_BOT_TOKEN'),
            string(credentialsId: 'telegram-chat-id', variable: 'TG_CHAT_ID')
        ]) {
            withEnv(["TELEGRAM_MESSAGE=${message}"]) {
                sh '''#!/bin/sh
                    curl -s -X POST "https://api.telegram.org/bot$TG_BOT_TOKEN/sendMessage" \
                        --data-urlencode "chat_id=$TG_CHAT_ID" \
                        --data-urlencode "text=$TELEGRAM_MESSAGE" \
                        --data-urlencode "parse_mode=HTML" > /dev/null || true
                '''
            }
        }
    } catch (Exception e) {
        echo "Telegram notification skipped: missing/invalid Jenkins credentials (telegram-bot-token, telegram-chat-id)."
    }
}

pipeline {
    agent any

    environment {
        // GitHub Container Registryy
        REGISTRY = 'ghcr.io'
        GITHUB_USERNAME = credentials('github-username')
        GITHUB_TOKEN = credentials('github-pat-global')
        APP_NAME = 'stock-pos-server'
        DOCKER_IMAGE = "${REGISTRY}/${GITHUB_USERNAME.toLowerCase()}/${APP_NAME}"
    }

    triggers {
        githubPush()
        pollSCM('H/5 * * * *')
    }

    options {
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 2, unit: 'HOURS')
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "=== Checking out code from repository ==="
                    notifyTelegram("🔨 <b>Build started</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>")
                    def scmVars = checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/nan']],
                        userRemoteConfigs: [[
                            url: 'git@github.com:techey-solution/stock-pos-server.git',
                            credentialsId: 'deploy-ssh-key'
                        ]]
                    ])
                    env.GIT_BRANCH = scmVars?.GIT_BRANCH ?: sh(script: "git rev-parse --abbrev-ref HEAD", returnStdout: true).trim()
                    env.GIT_COMMIT = scmVars?.GIT_COMMIT ?: sh(script: "git rev-parse HEAD", returnStdout: true).trim()
                    env.SHORT_COMMIT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    env.VERSION = sh(script: 'echo "${BUILD_NUMBER}-$(git rev-parse --short HEAD)"', returnStdout: true).trim()
                    sh '''
                        echo "Branch: ${GIT_BRANCH}"
                        echo "Commit: ${GIT_COMMIT}"
                        echo "Version: ${VERSION}"
                        git log -1 --oneline
                    '''
                }
            }
        }

        stage('Environment Setup') {
            steps {
                script {
                    echo "=== Verifying environment ==="
                    sh '''
                        node --version
                        npm --version
                        pnpm --version
                        docker --version
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "=== Installing project dependencies ==="
                    sh 'pnpm install --frozen-lockfile'
                }
            }
        }

        stage('Linting') {
            steps {
                script {
                    echo "=== Running ESLint ==="
                    sh 'pnpm lint || true'
                }
            }
        }

        stage('Format Check') {
            steps {
                script {
                    echo "=== Checking code formatting ==="
                    sh 'pnpm format:check || true'
                }
            }
        }

        stage('Build Application') {
            steps {
                script {
                    echo "=== Building TypeScript application ==="
                    sh '''
                        pnpm db:generate
                        pnpm build
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "=== Building Docker image for GHCR ==="
                    if (!env.VERSION?.trim()) {
                        env.VERSION = sh(script: 'echo "${BUILD_NUMBER}-$(git rev-parse --short HEAD)"', returnStdout: true).trim()
                    }
                    if (!env.VERSION?.trim()) {
                        error("VERSION is empty; cannot build Docker image tag.")
                    }
                    echo "Docker tag version: ${env.VERSION}"
                    sh '''
                        docker build \
                            --target production \
                            -t ${DOCKER_IMAGE}:${VERSION} \
                            -t ${DOCKER_IMAGE}:latest \
                            --label "org.opencontainers.image.source=https://github.com/${GITHUB_USERNAME}/stock-pos-server" \
                            --label "org.opencontainers.image.description=Stock POS Server Application" \
                            --label "org.opencontainers.image.version=${VERSION}" \
                            -f Dockerfile \
                            .
                        
                        echo "Built image: ${DOCKER_IMAGE}:${VERSION}"
                        docker image inspect ${DOCKER_IMAGE}:${VERSION}
                    '''
                }
            }
        }

        stage('Security Scan') {
            when {
                anyOf {
                    branch 'nan'
                    branch 'origin/nan'
                }
            }
            steps {
                script {
                    echo "=== Running security scan on Docker image ==="
                    sh '''
                        # Example: Using trivy for image scanning
                        # trivy image --severity HIGH,CRITICAL ${DOCKER_IMAGE}:${VERSION} || true
                        echo "Image: ${DOCKER_IMAGE}:${VERSION}"
                        echo "Security scan completed"
                    '''
                }
            }
        }

        stage('Push to GHCR') {
            steps {
                script {
                    echo "=== Pushing Docker image to GitHub Container Registry ==="
                    echo "Branch: ${env.GIT_BRANCH ?: env.BRANCH_NAME}"
                    
                    withCredentials([
                        string(credentialsId: 'github-pat-global', variable: 'GHCR_TOKEN')
                    ]) {
                        sh '''#!/bin/bash
                            set -e
                            
                            echo "=========================================="
                            echo "Docker Image Push to GHCR"
                            echo "=========================================="
                            echo "Registry: ${REGISTRY}"
                            echo "Username: ${GITHUB_USERNAME}"
                            echo "Image: ${DOCKER_IMAGE}"
                            echo "Tag: ${VERSION}"
                            echo "=========================================="
                            
                            # Login to GitHub Container Registry
                            echo "Logging into GHCR..."
                            echo "${GHCR_TOKEN}" | docker login ${REGISTRY} -u ${GITHUB_USERNAME} --password-stdin
                            
                            if [ $? -ne 0 ]; then
                                echo "✗ GHCR login failed!"
                                exit 1
                            fi
                            echo "✓ GHCR login successful"
                            
                            # Push versioned tag
                            echo ""
                            echo "Pushing versioned image: ${DOCKER_IMAGE}:${VERSION}"
                            docker push ${DOCKER_IMAGE}:${VERSION}
                            
                            if [ $? -ne 0 ]; then
                                echo "✗ Failed to push ${DOCKER_IMAGE}:${VERSION}"
                                docker logout ${REGISTRY}
                                exit 1
                            fi
                            echo "✓ Successfully pushed ${DOCKER_IMAGE}:${VERSION}"
                            
                            # Push latest tag
                            echo ""
                            echo "Pushing latest tag: ${DOCKER_IMAGE}:latest"
                            docker push ${DOCKER_IMAGE}:latest
                            
                            if [ $? -ne 0 ]; then
                                echo "✗ Failed to push ${DOCKER_IMAGE}:latest"
                                docker logout ${REGISTRY}
                                exit 1
                            fi
                            echo "✓ Successfully pushed ${DOCKER_IMAGE}:latest"
                            
                            # Verify the push
                            echo ""
                            echo "Verifying image in GHCR..."
                            docker pull ${DOCKER_IMAGE}:${VERSION}
                            
                            if [ $? -ne 0 ]; then
                                echo "✗ Image verification failed - cannot pull from GHCR"
                                docker logout ${REGISTRY}
                                exit 1
                            fi
                            echo "✓ Image verification successful"
                            
                            # Logout
                            docker logout ${REGISTRY}
                            
                            echo ""
                            echo "=========================================="
                            echo "✓ Push completed successfully!"
                            echo "Image: ${DOCKER_IMAGE}:${VERSION}"
                            echo "=========================================="
                        '''
                    }
                }
            }
            post {
                success {
                    script {
                        echo "=== Cleaning up old stock-pos-server Docker images ==="
                        sh '''
                            # Only remove old stock-pos-server images (not Jenkins or other images)
                            docker images ${DOCKER_IMAGE} --format "{{.ID}} {{.Tag}}" | \
                                grep -v "latest" | \
                                grep -v "${VERSION}" | \
                                awk '{print $1}' | \
                                xargs -r docker rmi -f || true
                            
                            # Prune only dangling images (untagged intermediate layers)
                            # This won't touch Jenkins or other tagged images
                            docker image prune -f
                            
                            echo "Docker cleanup completed - Jenkins images preserved"
                            docker images | grep -E "(stock-pos-server|jenkins)"
                        '''
                    }
                }
            }
        }

        stage('Deploy with Ansible') {
            when {
                expression { 
                    env.GIT_BRANCH == 'nan' || 
                    env.GIT_BRANCH == 'origin/nan' ||
                    env.BRANCH_NAME == 'nan'
                }
            }
            steps {
                script {
                    echo "=== Deploying to app server with Ansible ==="
                    echo "Target: app_servers (89.167.6.46)"
                    echo "Current branch: ${env.GIT_BRANCH ?: env.BRANCH_NAME}"
                    notifyTelegram("🚀 <b>Deploy started</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Env:</b> production\n• <b>Branch:</b> ${env.GIT_BRANCH ?: env.BRANCH_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Version:</b> ${VERSION}\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>")
                    
                    withCredentials([
                        string(credentialsId: 'ansible-vault-password', variable: 'VAULT_PASS')
                    ]) {
                        sshagent(['deploy-ssh-key']) {
                            sh '''
                                set -e
                                
                                # Debug: Check if vault password is set
                                if [ -z "${VAULT_PASS}" ]; then
                                    echo "ERROR: VAULT_PASS is empty! Check Jenkins credential 'ansible-vault-password'"
                                    exit 1
                                fi
                                echo "VAULT_PASS length: ${#VAULT_PASS}"
                                
                                # Create temporary vault password file (using printf for reliability)
                                printf '%s' "${VAULT_PASS}" > /tmp/vault_pass_${BUILD_NUMBER}.txt
                                chmod 600 /tmp/vault_pass_${BUILD_NUMBER}.txt
                                
                                # Debug: Check file size (should be same as password length)
                                echo "Vault password file size: $(wc -c < /tmp/vault_pass_${BUILD_NUMBER}.txt) bytes"
                                echo "Password length: ${#VAULT_PASS} chars"
                                
                                # Test if vault can be decrypted
                                echo "Testing vault decryption..."
                                ansible-vault view ansible/inventories/production/group_vars/all/vault.yml \
                                    --vault-password-file /tmp/vault_pass_${BUILD_NUMBER}.txt | head -5 || \
                                    echo "WARNING: Vault decryption failed - check password!"
                                
                                # Test SSH connection to backend server
                                echo "Testing SSH connection to app_servers..."
                                ssh -o StrictHostKeyChecking=no deployer@89.167.6.46 "docker ps" || echo "Warning: Could not verify backend connectivity"
                                
                                # Run Ansible deployment to app servers (NOT localhost)
                                echo "Running Ansible deployment..."
                                ansible-playbook ansible/playbooks/deploy.yml \
                                    -i ansible/inventories/production/hosts.ini \
                                    -l app_servers \
                                    --vault-password-file /tmp/vault_pass_${BUILD_NUMBER}.txt \
                                    -e "node_env=production" \
                                    -e "pull_images=true" \
                                    -e "build_image=false" \
                                    -e "run_db_migrations=true" \
                                    -e "run_db_seed=false" \
                                    -e "docker_registry=${REGISTRY}" \
                                    -e "docker_registry_username=${GITHUB_USERNAME}" \
                                    -e "docker_registry_password=${GITHUB_TOKEN}" \
                                    -e "docker_image_name=${APP_NAME}" \
                                    -e "docker_image_tag=${VERSION}" \
                                    -e "confirm_deploy=yes" \
                                    -vvv
                                
                                # Cleanup
                                rm -f /tmp/vault_pass_${BUILD_NUMBER}.txt
                                echo "Deployment completed successfully"
                            '''
                        }
                    }
                }
            }
            post {
                success {
                    script {
                        notifyTelegram("✅ <b>Deploy success</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Env:</b> production\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Version:</b> ${VERSION}\n• <b>URL:</b> https://familypos.techey.tech\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>")
                    }
                }
                failure {
                    script {
                        notifyTelegram("❌ <b>Deploy failed</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Env:</b> production\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Version:</b> ${VERSION}\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Open Build</a>\n• <b>Action:</b> Check console log")
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                notifyTelegram("✅ <b>Build completed</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Version:</b> ${VERSION}\n• <b>Status:</b> Success")
            }
        }
        failure {
            script {
                echo "❌ Build failed!"
                echo "Build: ${BUILD_NUMBER}"
                echo "Branch: ${env.GIT_BRANCH ?: env.BRANCH_NAME}"
                notifyTelegram("❌ <b>Build failed</b>\n• <b>App:</b> ${APP_NAME}\n• <b>Build:</b> #${BUILD_NUMBER}\n• <b>Jenkins:</b> <a href=\"${env.BUILD_URL}\">Console Log</a>")
            }
        }
        always {
            script {
                echo "=== Cleanup ==="
                
                // Clean up dangling and unused Docker resources (only if node is available)
                try {
                    node {
                        sh '''
                            # Remove dangling images
                            docker image prune -f
                            
                            # Remove unused build cache
                            docker builder prune -f --filter "until=24h"
                            
                            echo "Docker system cleanup completed"
                        '''
                        
                        cleanWs()
                    }
                } catch (Exception e) {
                    echo "Cleanup skipped - node context not available: ${e.message}"
                }
            }
        }
    }
}
