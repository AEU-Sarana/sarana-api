# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_VERSION=v1

#App Timezone
TZ=Asia/Phnom_Penh

#API URL
API_BASE_URL=https://initiative-congressional-cams-pos.trycloudflare.com     

# Nginx host ports (IMPORTANT: make this match API_BASE_URL)
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/stock_pos"

#Database (Docker)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stock_pos
DB_HOST=db
DB_PORT=5433

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=24h
JWT_REFRESH_TOKEN_EXPIRY=7d

#JWT V2
JWT_V2_ACCESS_TOKEN_EXPIRY=1000m
JWT_V2_REFRESH_ABSOLUTE_DAYS=30
JWT_V2_REFRESH_IDLE_DAYS=7
JWT_ISSUER=stock-pos-api
JWT_AUDIENCE=stock-pos-mobile

# Optional: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Token Blacklist (Redis)
REDIS_URL=redis://localhost:6380
REDIS_TOKEN_BLACKLIST_TTL=86400

# Email Service (for password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@stockpos.com

# Brevo (Sendinblue) API
BREVO_API_KEY=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
BREVO_SENDER_EMAIL=noreply@techey.tech
BREVO_SENDER_NAME=Stock POS

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"

