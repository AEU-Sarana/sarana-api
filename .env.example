# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
API_VERSION=v1

#App Timezone
TZ=Asia/Phnom_Penh

#API URL
# API_BASE_URL=http://192.168.18.10:8080
API_BASE_URL=https://remained-medicaid-rich-baghdad.trycloudflare.com

# Nginx host ports (IMPORTANT: make this match API_BASE_URL)
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@db:5432/stock_pos

#Database (Docker)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stock_pos
DB_HOST=db
DB_PORT=5433

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

JWT_V2_ACCESS_TOKEN_EXPIRY=10m
JWT_V2_REFRESH_ABSOLUTE_DAYS=30
JWT_V2_REFRESH_IDLE_DAYS=7
JWT_ISSUER=stock-pos-api
JWT_AUDIENCE=stock-pos-mobile

# Optional: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Password Hashing
BCRYPT_SALT_ROUNDS=12

#Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Token Blacklist (optional - Redis)
REDIS_URL=redis://redis:6379
REDIS_TOKEN_BLACKLIST_TTL=86400


# Email Service (for password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@stockpos.com


# Brevo (Sendinblue) API
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@techey.tech
BREVO_SENDER_NAME=Stock POS


# Object Storage (MinIO)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=stock-pos-storage
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000/stock-pos-storage

# MinIO Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

ENCRYPTION_KEY=
