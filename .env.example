# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_VERSION=v1

#API URL
API_BASE_URL=http://192.168.18.10:8080

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/stock_pos_db"

#Database (Docker)
DB_USER=postgres
DB_PASSWORD=admin123
DB_NAME=stock_pos
DB_PORT=5433

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Optional: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Password Hashing
BCRYPT_SALT_ROUNDS=12


# Token Blacklist (optional - Redis)
REDIS_URL=redis://localhost:6379
REDIS_TOKEN_BLACKLIST_TTL=86400


# Email Service (for password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@stockpos.com


# Brevo (Sendinblue) API
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@techey.tech
BREVO_SENDER_NAME=Stock POS


# Object Storage (MinIO)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=stock-pos-storage
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000/stock-pos-storage

# MinIO Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

ENCRYPTION_KEY=