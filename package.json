{
  "name": "stock-pos-server",
  "version": "1.0.0",
  "description": "Stock POS System Backend API",
  "type": "commonjs",
  "main": "dist/index.js",
  "prisma": {
    "schema": "src/database/generated/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc && tsc-alias && node copy-generated.mjs",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "node --test --import tsx",
    "db:seed": "tsx src/database/prisma/seed.ts",
    "seed": "tsx src/seeders/index.ts",
    "seed:all": "tsx src/seeders/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "node refresh-db.mjs --force && node apply-domain-migrations.mjs apply",
    "migrate:apply": "node apply-domain-migrations.mjs apply",
    "migrate:single": "node apply-single-migration.mjs",
    "migrate:rollback": "node rollback-domain-migrations.mjs",
    "migrate:reset:all": "node rollback-domain-migrations.mjs all && node apply-domain-migrations.mjs apply",
    "migrate:refresh": "node refresh-db.mjs --force && node apply-domain-migrations.mjs apply",
    "migrate:check": "node check-migrations.mjs",
    "seed:check": "node check-seeded-data.mjs",
    "db:migrate:resolve": "prisma migrate resolve",
    "db:generate": "node db-generate.mjs",
    "db:pull": "prisma db pull --schema src/database/prisma/introspected.prisma",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:khmer": "tsx scripts/test-khmer-receipt.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "_moduleAliases": {
    "@src": "dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.986.0",
    "@aws-sdk/s3-request-presigner": "^3.986.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@prisma/client-runtime-utils": "7.3.0",
    "@prisma/engines": "^7.3.0",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "bullmq": "^5.67.3",
    "canvas": "^3.2.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "morgan": "^1.10.1",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.18.0",
    "pdfkit": "^0.17.2",
    "sharp": "^0.34.5",
    "sib-api-v3-sdk": "^8.5.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.2",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "prisma": "^7.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "directories": {
    "doc": "doc"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "bcrypt",
      "canvas",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  }
}
