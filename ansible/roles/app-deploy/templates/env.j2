NODE_ENV={{ app_env }}
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}

# Redis
REDIS_URL=redis://{{ redis_host }}:{{ redis_port }}

# JWT
JWT_SECRET={{ jwt_secret }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret }}
JWT_ACCESS_TOKEN_EXPIRY=24h
JWT_REFRESH_TOKEN_EXPIRY=7d

# Password
BCRYPT_SALT_ROUNDS=12

# CORS
ALLOWED_ORIGINS={{ allowed_origins | default('http://localhost:3000') }}

# Email (optional)
SMTP_HOST={{ smtp_host | default('') }}
SMTP_PORT={{ smtp_port | default('587') }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASS={{ smtp_pass | default('') }}
SMTP_FROM={{ smtp_from | default('noreply@stockpos.com') }}
