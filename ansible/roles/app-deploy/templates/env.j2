# Environment Configuration for {{ app_name }}
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# Node Environment
NODE_ENV={{ node_env | default('production') }}

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER={{ db_user | default('stockpos') }}
DB_PASSWORD={{ db_password | default('CHANGE_ME_IN_VAULT') }}
DB_NAME={{ db_name | default('stock_pos') }}
DB_EXTERNAL_PORT={{ db_port | default('5433') }}
DATABASE_URL=postgresql://{{ db_user | default('stockpos') }}:{{ db_password | default('CHANGE_ME_IN_VAULT') }}@db:5432/{{ db_name | default('stock_pos') }}

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT={{ redis_port | default('6380') }}

# Minio Configuration
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER={{ minio_root_user | default('minioadmin') }}
MINIO_ROOT_PASSWORD={{ minio_root_password | default('CHANGE_ME_IN_VAULT') }}
MINIO_API_PORT={{ minio_api_port | default('9000') }}
MINIO_CONSOLE_PORT={{ minio_console_port | default('9001') }}
MINIO_USE_SSL=false
MINIO_BUCKET_NAME={{ app_name }}-storage

# Storage Configuration (S3/MinIO)
STORAGE_PROVIDER={{ storage_provider | default('minio') }}
STORAGE_ENDPOINT={{ storage_endpoint | default('http://minio:9000') }}
STORAGE_ACCESS_KEY={{ storage_access_key | default(minio_root_user | default('minioadmin')) }}
STORAGE_SECRET_KEY={{ storage_secret_key | default(minio_root_password | default('CHANGE_ME_IN_VAULT')) }}
STORAGE_BUCKET={{ storage_bucket | default(app_name ~ '-storage') }}
STORAGE_REGION={{ storage_region | default('us-east-1') }}
STORAGE_USE_SSL={{ storage_use_ssl | default('false') }}
STORAGE_PUBLIC_URL={{ storage_public_url | default('') }}

# Application Configuration
APP_PORT=3000
APP_HOST=0.0.0.0
APP_NAME={{ app_name }}

# JWT Configuration (Generate secure keys)
JWT_SECRET={{ jwt_secret | default('CHANGE_THIS_SECRET_KEY_IN_PRODUCTION') }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret | default('CHANGE_THIS_REFRESH_SECRET_KEY_IN_PRODUCTION') }}
JWT_ACCESS_TOKEN_EXPIRY={{ jwt_access_token_expiry | default('24h') }}
JWT_REFRESH_TOKEN_EXPIRY={{ jwt_refresh_token_expiry | default('7d') }}
JWT_EXPIRES_IN={{ jwt_expires_in | default('7d') }}

# Nginx Configuration
NGINX_HTTP_PORT={{ nginx_http_port | default('8081') }}
NGINX_HTTPS_PORT={{ nginx_https_port | default('8443') }}

# Logging
LOG_LEVEL={{ log_level | default('info') }}

# CORS Configuration
CORS_ORIGIN={{ cors_origin | default('*') }}