# Environment Configuration for {{ app_name | default('stock-pos') }}
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
{% set use_minio = (storage_provider | default('minio') | lower) == 'minio' %}

# ===============================
# Server
# ===============================
NODE_ENV={{ node_env | default('production') }}
HOST={{ host | default('0.0.0.0') }}
PORT={{ app_port | default(3000) }}
APP_HOST={{ app_host | default(host | default('0.0.0.0')) }}
APP_PORT={{ app_port | default(3000) }}
API_VERSION={{ api_version | default('v1') }}

# ===============================
# App Timezone
# ===============================
TZ={{ system_timezone | default('UTC') }}
SYSTEM_TIMEZONE={{ system_timezone | default('UTC') }}
DB_TIMEZONE={{ db_timezone | default('UTC') }}

# ===============================
# API URL
# ===============================
API_BASE_URL={{ api_base_url | default('https://' + (app_domain | default('localhost'))) }}
APP_URL={{ app_url | default(api_base_url | default('https://' + (app_domain | default('localhost')))) }}
FRONTEND_URL={{ frontend_url | default('') }}

# Nginx host ports
NGINX_HTTP_PORT={{ nginx_http_port | default(80) }}
NGINX_HTTPS_PORT={{ nginx_https_port | default(443) }}

# ===============================
# Database (PostgreSQL)
# ===============================
DATABASE_URL=postgresql://{{ db_user | default('postgres') }}:{{ (db_password | default('') | urlencode) }}@{{ db_host | default('db') }}:{{ db_port | default(5432) }}/{{ db_name | default('stock_pos') }}

# Database (Docker)
DB_HOST={{ db_host | default('db') }}
DB_PORT={{ db_port | default(5432) }}
DB_USER={{ db_user | default('postgres') }}
DB_PASSWORD={{ (db_password | default('')) | string }}
DB_NAME={{ db_name | default('stock_pos') }}
DB_EXTERNAL_PORT={{ db_external_port | default(5433) }}

# ===============================
# JWT
# ===============================
JWT_SECRET={{ jwt_secret | default('CHANGE_THIS_SECRET_KEY_IN_PRODUCTION') }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret | default('CHANGE_THIS_REFRESH_SECRET_IN_PRODUCTION') }}
JWT_EXPIRES_IN={{ jwt_expires_in | default('24h') }}
JWT_REFRESH_EXPIRES_IN={{ jwt_refresh_token_expiry | default('7d') }}
JWT_EXPIRATION={{ jwt_expires_in | default('24h') }}
JWT_ACCESS_TOKEN_EXPIRY={{ jwt_access_token_expiry | default('24h') }}
JWT_REFRESH_TOKEN_EXPIRY={{ jwt_refresh_token_expiry | default('7d') }}

# JWT V2
JWT_V2_ACCESS_TOKEN_EXPIRY={{ jwt_v2_access_token_expiry | default('1000m') }}
JWT_V2_REFRESH_ABSOLUTE_DAYS={{ jwt_v2_refresh_absolute_days | default(30) }}
JWT_V2_REFRESH_IDLE_DAYS={{ jwt_v2_refresh_idle_days | default(7) }}
JWT_ISSUER={{ jwt_issuer | default('stock-pos-api') }}
JWT_AUDIENCE={{ jwt_audience | default('stock-pos-mobile') }}

# ===============================
# Telegram (Optional)
# ===============================
TELEGRAM_BOT_TOKEN={{ telegram_bot_token | default('') }}
TELEGRAM_CHAT_ID={{ telegram_chat_id | default('') }}
TELEGRAM_WEBHOOK_SECRET={{ telegram_webhook_secret | default('') }}

# ===============================
# Password Hashing
# ===============================
BCRYPT_SALT_ROUNDS={{ bcrypt_salt_rounds | default(12) }}

# ===============================
# Redis
# ===============================
REDIS_HOST={{ redis_host | default('redis') }}
REDIS_PORT={{ redis_internal_port | default(6379) }}
REDIS_PASSWORD={{ redis_password | default('') }}
REDIS_URL={{ redis_url | default('redis://' + (redis_host | default('redis')) + ':' + (redis_internal_port | default(6379) | string)) }}
REDIS_EXTERNAL_PORT={{ redis_port | default(6380) }}
REDIS_TOKEN_BLACKLIST_TTL={{ redis_token_blacklist_ttl | default(86400) }}

# ===============================
# Email Service (Optional SMTP)
# ===============================
SMTP_HOST={{ smtp_host | default('') }}
SMTP_PORT={{ smtp_port | default(587) }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASS={{ smtp_pass | default('') }}
SMTP_FROM={{ smtp_from | default('noreply@stockpos.com') }}
EMAIL_FROM={{ email_from | default(smtp_from | default('noreply@stockpos.com')) }}

# ===============================
# Brevo (Sendinblue)
# ===============================
BREVO_API_KEY={{ brevo_api_key | default('') }}
BREVO_SENDER_EMAIL={{ brevo_sender_email | default('noreply@stockpos.com') }}
BREVO_SENDER_NAME={{ brevo_sender_name | default('Stock POS') }}

# ===============================
# CORS
# ===============================
CORS_ORIGIN={{ cors_origin | default('*') }}
ALLOWED_ORIGINS={{ allowed_origins | default('*') }}

# ===============================
# Storage (MinIO / S3 Compatible)
# ===============================
STORAGE_PROVIDER={{ storage_provider | default('minio') }}
STORAGE_ENDPOINT={{ storage_endpoint | default('http://minio:9000' if use_minio else '') }}
STORAGE_ACCESS_KEY={{ storage_access_key | default((minio_root_user | default('minioadmin')) if use_minio else '') }}
STORAGE_SECRET_KEY={{ storage_secret_key | default((minio_root_password | default('')) if use_minio else '') }}
STORAGE_BUCKET={{ storage_bucket | default((app_name | default('stock-pos')) + '-storage') }}
STORAGE_REGION={{ storage_region | default('us-east-1') }}
STORAGE_USE_SSL={{ storage_use_ssl | default('false') }}
STORAGE_PUBLIC_URL={{ storage_public_url | default('') }}

# MinIO credentials
MINIO_ROOT_USER={{ minio_root_user | default('minioadmin') }}
MINIO_ROOT_PASSWORD={{ minio_root_password | default('') }}
MINIO_API_PORT={{ minio_api_port | default(9000) }}
MINIO_CONSOLE_PORT={{ minio_console_port | default(9001) }}

{% if use_minio %}
# MinIO service defaults
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME={{ (app_name | default('stock-pos')) }}-storage
{% endif %}

# ===============================
# Cloudflare R2 (Optional)
# ===============================
R2_ACCOUNT_ID={{ r2_account_id | default('') }}
R2_ACCESS_KEY_ID={{ r2_access_key_id | default('') }}
R2_SECRET_ACCESS_KEY={{ r2_secret_access_key | default('') }}
R2_BUCKET_NAME={{ r2_bucket_name | default('') }}
R2_ENDPOINT={{ r2_endpoint | default('') }}

# ===============================
# Security / Encryption
# ===============================
ENCRYPTION_KEY={{ vault_app_secret_key | default('CHANGE_ME_IN_VAULT_32_BYTES_BASE64') }}
BACKUP_ENCRYPTION_KEY={{ backup_encryption_key | default('') }}
RECEIPT_QR_HMAC_SECRET={{ receipt_qr_hmac_secret | default('') }}

# Logging
LOG_LEVEL={{ log_level | default('info') }}
