# Docker Compose Production Override
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

services:
  # Application Service (Express)
  app:
    image: "{{ docker_registry }}/{{ docker_registry_username | lower }}/{{ docker_image_name }}:{{ docker_image_tag }}"
    container_name: {{ app_name }}-app
    build:
      context: .
      dockerfile: Dockerfile
      args:
        NODE_ENV: production
    env_file:
      - .env
    environment:
      - NODE_ENV=${NODE_ENV:-production}
      - DB_HOST=db
      - DB_PORT=5432
      - DB_USER=${DB_USER}
      - DB_PASSWORD=${DB_PASSWORD}
      - DB_NAME=${DB_NAME}
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - MINIO_ENDPOINT=minio
      - MINIO_PORT=9000
      - MINIO_ROOT_USER=${MINIO_ROOT_USER}
      - MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD}
      - STORAGE_ENDPOINT=${STORAGE_ENDPOINT:-http://minio:9000}
      - STORAGE_ACCESS_KEY=${STORAGE_ACCESS_KEY:-${MINIO_ROOT_USER}}
      - STORAGE_SECRET_KEY=${STORAGE_SECRET_KEY:-${MINIO_ROOT_PASSWORD}}
      - STORAGE_BUCKET=${STORAGE_BUCKET:-{{ app_name }}-storage}
      - APP_PORT=${APP_PORT:-3000}
      - JWT_SECRET=${JWT_SECRET}
      - JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
      - JWT_ACCESS_TOKEN_EXPIRY=${JWT_ACCESS_TOKEN_EXPIRY:-24h}
      - JWT_REFRESH_TOKEN_EXPIRY=${JWT_REFRESH_TOKEN_EXPIRY:-7d}
      - JWT_EXPIRES_IN=${JWT_EXPIRES_IN:-24h}
      - ENCRYPTION_KEY=${ENCRYPTION_KEY}
    ports:
      - "3000:3000"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      minio:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    networks:
      - {{ app_name }}-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
{% if deploy_replicas is defined and deploy_replicas > 1 %}
    deploy:
      replicas: {{ deploy_replicas }}
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
{% endif %}