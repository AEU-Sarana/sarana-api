# Docker Compose Production Override
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

{% set use_minio = (storage_provider | default('minio') | lower) == 'minio' %}

services:
{% if blue_green_enabled | default(false) | bool %}
  # Application Service (Express) - Blue
  app-blue:
    image: "{{ docker_registry }}/{{ (docker_registry_namespace | default(docker_registry_username)) | lower }}/{{ docker_image_name }}:{{ app_blue_image_tag | default(docker_image_tag) }}"
    container_name: {{ app_name }}-app-blue
    build:
      context: .
      dockerfile: Dockerfile
      args:
        NODE_ENV: production
    env_file:
      - .env
    environment:
      - NODE_ENV=${NODE_ENV:-production}
      - DB_HOST=db
      - DB_PORT=5432
      - DB_USER=${DB_USER}
      - DB_PASSWORD=${DB_PASSWORD}
      - DB_NAME=${DB_NAME}
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - APP_PORT=3000
      - JWT_SECRET=${JWT_SECRET:-CHANGE_THIS_SECRET_KEY_IN_PRODUCTION}
      - JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET:-CHANGE_THIS_REFRESH_SECRET_KEY_IN_PRODUCTION}
      - JWT_ACCESS_TOKEN_EXPIRY=${JWT_ACCESS_TOKEN_EXPIRY:-24h}
      - JWT_REFRESH_TOKEN_EXPIRY=${JWT_REFRESH_TOKEN_EXPIRY:-7d}
      - JWT_EXPIRES_IN=${JWT_EXPIRES_IN:-7d}
      - STORAGE_PROVIDER=${STORAGE_PROVIDER:-{{ storage_provider | default('minio') }}}
      - STORAGE_ENDPOINT=${STORAGE_ENDPOINT:-{{ storage_endpoint | default('http://minio:9000') }}}
      - STORAGE_ACCESS_KEY=${STORAGE_ACCESS_KEY:-{{ storage_access_key | default('') }}}
      - STORAGE_SECRET_KEY=${STORAGE_SECRET_KEY:-{{ storage_secret_key | default('') }}}
      - STORAGE_BUCKET=${STORAGE_BUCKET:-{{ storage_bucket | default(app_name + '-storage') }}}
      - STORAGE_REGION=${STORAGE_REGION:-{{ storage_region | default('us-east-1') }}}
      - STORAGE_USE_SSL=${STORAGE_USE_SSL:-{{ storage_use_ssl | default('false') }}}
      - STORAGE_PUBLIC_URL=${STORAGE_PUBLIC_URL:-}
    ports:
      - "127.0.0.1:{{ blue_app_port }}:3000"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
{% if use_minio %}
      minio:
        condition: service_healthy
{% endif %}
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 40s
    networks:
      - internal-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
{% if deploy_replicas is defined and deploy_replicas > 1 %}
    deploy:
      replicas: {{ deploy_replicas }}
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
{% endif %}

  # Application Service (Express) - Green
  app-green:
    image: "{{ docker_registry }}/{{ (docker_registry_namespace | default(docker_registry_username)) | lower }}/{{ docker_image_name }}:{{ app_green_image_tag | default(docker_image_tag) }}"
    container_name: {{ app_name }}-app-green
    build:
      context: .
      dockerfile: Dockerfile
      args:
        NODE_ENV: production
    env_file:
      - .env
    environment:
      - NODE_ENV=${NODE_ENV:-production}
      - DB_HOST=db
      - DB_PORT=5432
      - DB_USER=${DB_USER}
      - DB_PASSWORD=${DB_PASSWORD}
      - DB_NAME=${DB_NAME}
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - APP_PORT=3000
      - JWT_SECRET=${JWT_SECRET:-CHANGE_THIS_SECRET_KEY_IN_PRODUCTION}
      - JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET:-CHANGE_THIS_REFRESH_SECRET_KEY_IN_PRODUCTION}
      - JWT_ACCESS_TOKEN_EXPIRY=${JWT_ACCESS_TOKEN_EXPIRY:-24h}
      - JWT_REFRESH_TOKEN_EXPIRY=${JWT_REFRESH_TOKEN_EXPIRY:-7d}
      - JWT_EXPIRES_IN=${JWT_EXPIRES_IN:-7d}
      - STORAGE_PROVIDER=${STORAGE_PROVIDER:-{{ storage_provider | default('minio') }}}
      - STORAGE_ENDPOINT=${STORAGE_ENDPOINT:-{{ storage_endpoint | default('http://minio:9000') }}}
      - STORAGE_ACCESS_KEY=${STORAGE_ACCESS_KEY:-{{ storage_access_key | default('') }}}
      - STORAGE_SECRET_KEY=${STORAGE_SECRET_KEY:-{{ storage_secret_key | default('') }}}
      - STORAGE_BUCKET=${STORAGE_BUCKET:-{{ storage_bucket | default(app_name + '-storage') }}}
      - STORAGE_REGION=${STORAGE_REGION:-{{ storage_region | default('us-east-1') }}}
      - STORAGE_USE_SSL=${STORAGE_USE_SSL:-{{ storage_use_ssl | default('false') }}}
      - STORAGE_PUBLIC_URL=${STORAGE_PUBLIC_URL:-}
    ports:
      - "127.0.0.1:{{ green_app_port }}:3000"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
{% if use_minio %}
      minio:
        condition: service_healthy
{% endif %}
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 40s
    networks:
      - internal-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
{% if deploy_replicas is defined and deploy_replicas > 1 %}
    deploy:
      replicas: {{ deploy_replicas }}
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
{% endif %}
{% else %}
  # Application Service (Express)
  app:
    image: "{{ docker_registry }}/{{ (docker_registry_namespace | default(docker_registry_username)) | lower }}/{{ docker_image_name }}:{{ docker_image_tag }}"
    container_name: {{ app_name }}-app
    build:
      context: .
      dockerfile: Dockerfile
      args:
        NODE_ENV: production
    env_file:
      - .env
    environment:
      - NODE_ENV=${NODE_ENV:-production}
      - DB_HOST=db
      - DB_PORT=5432
      - DB_USER=${DB_USER}
      - DB_PASSWORD=${DB_PASSWORD}
      - DB_NAME=${DB_NAME}
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - APP_PORT=${APP_PORT:-3000}
      - JWT_SECRET=${JWT_SECRET:-CHANGE_THIS_SECRET_KEY_IN_PRODUCTION}
      - JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET:-CHANGE_THIS_REFRESH_SECRET_KEY_IN_PRODUCTION}
      - JWT_ACCESS_TOKEN_EXPIRY=${JWT_ACCESS_TOKEN_EXPIRY:-24h}
      - JWT_REFRESH_TOKEN_EXPIRY=${JWT_REFRESH_TOKEN_EXPIRY:-7d}
      - JWT_EXPIRES_IN=${JWT_EXPIRES_IN:-7d}
      - STORAGE_PROVIDER=${STORAGE_PROVIDER:-{{ storage_provider | default('minio') }}}
      - STORAGE_ENDPOINT=${STORAGE_ENDPOINT:-{{ storage_endpoint | default('http://minio:9000') }}}
      - STORAGE_ACCESS_KEY=${STORAGE_ACCESS_KEY:-{{ storage_access_key | default('') }}}
      - STORAGE_SECRET_KEY=${STORAGE_SECRET_KEY:-{{ storage_secret_key | default('') }}}
      - STORAGE_BUCKET=${STORAGE_BUCKET:-{{ storage_bucket | default(app_name + '-storage') }}}
      - STORAGE_REGION=${STORAGE_REGION:-{{ storage_region | default('us-east-1') }}}
      - STORAGE_USE_SSL=${STORAGE_USE_SSL:-{{ storage_use_ssl | default('false') }}}
      - STORAGE_PUBLIC_URL=${STORAGE_PUBLIC_URL:-}
    ports:
      - "3000:3000"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
{% if use_minio %}
      minio:
        condition: service_healthy
{% endif %}
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 40s
    networks:
      - internal-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
{% if deploy_replicas is defined and deploy_replicas > 1 %}
    deploy:
      replicas: {{ deploy_replicas }}
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
{% endif %}
{% endif %}
