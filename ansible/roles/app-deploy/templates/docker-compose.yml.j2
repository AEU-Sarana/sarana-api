# Docker Compose Configuration for {{ app_name }}
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

services:
  # Application Service (Express) - Defined properly in docker-compose.prod.yml override
  # Using the GHCR registry image from Jenkins build
  app:
    image: "{{ docker_registry }}/{{ docker_image_name }}:{{ docker_image_tag }}"
    container_name: {{ app_name }}-app

  # Database
  db:
    image: postgres:15-alpine
    container_name: {{ app_name }}-db
    environment:
      POSTGRES_USER: ${DB_USER:-postgres}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-postgres}
      POSTGRES_DB: ${DB_NAME:-stock_pos}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    ports:
      - "${DB_EXTERNAL_PORT:-5433}:5432"
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-postgres}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - {{ app_name }}-network

  # Redis for Bull Queue
  redis:
    image: redis:7-alpine
    container_name: {{ app_name }}-redis
    ports:
      - "${REDIS_EXTERNAL_PORT:-6380}:6379"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - {{ app_name }}-network

  # Minio for object storage
  minio:
    image: minio/minio:latest
    container_name: {{ app_name }}-minio
    ports:
      - "${MINIO_API_PORT:-9000}:9000"
      - "${MINIO_CONSOLE_PORT:-9001}:9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-minioadmin}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-minioadmin}
    volumes:
      - minio-data:/data
    command: server /data --console-address ":9001"
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 30s
      timeout: 20s
      retries: 3
    restart: unless-stopped
    networks:
      - {{ app_name }}-network

  # Nginx reverse proxy
  nginx:
    image: nginx:alpine
    container_name: {{ app_name }}-nginx
    ports:
      - "${NGINX_HTTP_PORT:-8081}:80"
      - "${NGINX_HTTPS_PORT:-8443}:443"
    volumes:
      - ./docker/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./docker/nginx/conf.d:/etc/nginx/conf.d:ro
      - ./docker/nginx/ssl:/etc/nginx/ssl:ro
      - nginx-cache:/var/cache/nginx
      - nginx-logs:/var/log/nginx
    depends_on:
      - app
    restart: unless-stopped
    networks:
      - {{ app_name }}-network

volumes:
  postgres-data:
  nginx-cache:
  nginx-logs:
  minio-data:

networks:
  {{ app_name }}-network:
    driver: bridge