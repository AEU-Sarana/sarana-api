# Docker Compose Configuration for {{ app_name }}
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# NOTE: This file uses internal/external network architecture
# - internal-network: Private network for all containers (db, redis, minio, app)
# - external-network: Public network (only nginx exposed)

services:
{% if blue_green_enabled | default(false) | bool %}
  # Application Service (Express) - Blue
  app-blue:
    image: "{{ docker_registry }}/{{ docker_registry_username | lower }}/{{ docker_image_name }}:{{ app_blue_image_tag | default(docker_image_tag) }}"
    container_name: {{ app_name }}-app-blue
    env_file:
      - .env
    environment:
      - NODE_ENV=${NODE_ENV:-production}
      - APP_PORT=3000
    ports:
      - "127.0.0.1:{{ blue_app_port }}:3000"
    expose:
      - "3000"
    depends_on:
      - db
      - redis
      - minio
    restart: unless-stopped
    networks:
      - internal-network

  # Application Service (Express) - Green
  app-green:
    image: "{{ docker_registry }}/{{ docker_registry_username | lower }}/{{ docker_image_name }}:{{ app_green_image_tag | default(docker_image_tag) }}"
    container_name: {{ app_name }}-app-green
    env_file:
      - .env
    environment:
      - NODE_ENV=${NODE_ENV:-production}
      - APP_PORT=3000
    ports:
      - "127.0.0.1:{{ green_app_port }}:3000"
    expose:
      - "3000"
    depends_on:
      - db
      - redis
      - minio
    restart: unless-stopped
    networks:
      - internal-network
{% else %}
  # Application Service (Express)
  app:
    image: "{{ docker_registry }}/{{ docker_registry_username | lower }}/{{ docker_image_name }}:{{ docker_image_tag }}"
    container_name: {{ app_name }}-app
    env_file:
      - .env
    environment:
      - NODE_ENV=${NODE_ENV:-production}
    expose:
      - "3000"
    depends_on:
      - db
      - redis
      - minio
    restart: unless-stopped
    networks:
      - internal-network
{% endif %}

  # Database (private network only)
  db:
    image: postgres:15-alpine
    container_name: {{ app_name }}-db
    environment:
      POSTGRES_USER: ${DB_USER:-postgres}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-postgres}
      POSTGRES_DB: ${DB_NAME:-stock_pos}
      PGTZ: ${DB_TIMEZONE:-UTC}
      TZ: ${SYSTEM_TIMEZONE:-UTC}
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - ./docker/postgres/init-timezone.sql:/docker-entrypoint-initdb.d/01-timezone.sql
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-postgres}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - internal-network

  # Redis for Bull Queue (private network only)
  redis:
    image: redis:7-alpine
    container_name: {{ app_name }}-redis
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - internal-network

  # Minio for object storage (private network only)
  minio:
    image: minio/minio:latest
    container_name: {{ app_name }}-minio
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-minioadmin}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-minioadmin}
    volumes:
      - minio-data:/data
    command: server /data --console-address ":9001"
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 30s
      timeout: 20s
      retries: 3
    restart: unless-stopped
    networks:
      - internal-network

{% if node_exporter_enabled | default(true) | bool %}
  # Node Exporter for host metrics
  node-exporter:
    image: prom/node-exporter:latest
    container_name: {{ app_name }}-node-exporter
    command:
      - "--path.rootfs=/host"
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($|/)"
    ports:
      - "{{ node_exporter_bind_address | default('127.0.0.1') }}:{{ node_exporter_port | default(9100) }}:9100"
    pid: host
    restart: unless-stopped
    read_only: true
    volumes:
      - /:/host:ro,rslave
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://127.0.0.1:9100/metrics || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s
    networks:
      - internal-network
{% endif %}

  # Nginx reverse proxy (both networks: internal for app, external for public)
  nginx:
    image: nginx:alpine
    container_name: {{ app_name }}-nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./docker/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./docker/nginx/conf.d:/etc/nginx/conf.d:ro
      - ./docker/nginx/ssl:/etc/nginx/ssl:ro
      - nginx-cache:/var/cache/nginx
      - nginx-logs:/var/log/nginx
    depends_on:
{% if blue_green_enabled | default(false) | bool %}
      - app-blue
      - app-green
{% else %}
      - app
{% endif %}
    restart: unless-stopped
    networks:
      - internal-network
      - external-network

volumes:
  postgres-data:
  redis-data:
  minio-data:
  nginx-cache:
  nginx-logs:

networks:
  # Private network for internal container communication
  internal-network:
    driver: bridge
  
  # Public network for external access (only nginx exposed)
  external-network:
    driver: bridge
