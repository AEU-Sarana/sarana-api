---
# Example group_vars for production environment
# Copy to: ansible/group_vars/prod.yml
# ⚠️  USE ANSIBLE VAULT FOR ALL SECRETS

app_env: production
environment: production
app_version: "{{ jenkins_build_version }}"  # Set by Jenkins

# Docker Configuration
docker_registry: registry.example.com
docker_container_name: stock-pos-app
docker_network: stock-pos-network
deploy_path: /opt/stock-pos-server

# Database Configuration
postgres_user: "{{ vault_prod_postgres_user }}"
postgres_password: "{{ vault_prod_postgres_password }}"
postgres_host: db-prod.example.com
postgres_port: 5432
postgres_db: stock_pos_prod

# Redis Configuration
redis_host: redis-prod.example.com
redis_port: 6379

# JWT Configuration (MUST use Ansible vault!)
jwt_secret: "{{ vault_prod_jwt_secret }}"
jwt_refresh_secret: "{{ vault_prod_jwt_refresh_secret }}"

# CORS - Strict for production
allowed_origins: "https://app.example.com"

# SMTP Configuration
smtp_host: "{{ vault_smtp_host }}"
smtp_port: 587
smtp_user: "{{ vault_smtp_user }}"
smtp_pass: "{{ vault_smtp_password }}"
smtp_from: "noreply@stockpos.com"

# Application Port
app_port: 3000

# Deployment Options
run_migrations: false  # Generally false for production

# Production Resource Limits
docker_cpu_limit: "2"
docker_memory_limit: "2G"
docker_cpu_reservation: "1"
docker_memory_reservation: "1G"

# Health Check
health_check_interval: 30
health_check_timeout: 10
health_check_retries: 3
health_check_start_period: 40

# Production-specific settings
restart_policy: "always"
log_driver: "json-file"
log_options:
  max_size: "10m"
  max_file: "3"
