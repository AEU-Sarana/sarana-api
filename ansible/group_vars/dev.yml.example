---
# Example group_vars for development environment
# Copy to: ansible/group_vars/dev.yml

# Application Settings
app_env: development
environment: development
app_version: latest

# Docker Configuration
docker_registry: registry.example.com
docker_container_name: stock-pos-app-dev
docker_network: stock-pos-network
deploy_path: /opt/stock-pos-server

# Database Configuration (Docker network hostname)
postgres_user: postgres
postgres_password: postgres
postgres_host: db
postgres_port: 5432
postgres_db: stock_pos_dev

# Redis Configuration
redis_host: redis
redis_port: 6379

# JWT Configuration (use actual secrets in production)
jwt_secret: "dev-secret-key-change-in-production"
jwt_refresh_secret: "dev-refresh-secret-key-change-in-production"

# CORS
allowed_origins: "http://localhost:3000,http://localhost:3001"

# Application Port
app_port: 3000

# Deployment Options
run_migrations: false  # Set true to run migrations in dev

# Resource Limits for dev (lower than production)
docker_cpu_limit: "0.5"
docker_memory_limit: "512M"
docker_cpu_reservation: "0.25"
docker_memory_reservation: "256M"

# Health Check
health_check_interval: 30
health_check_timeout: 10
health_check_retries: 3
health_check_start_period: 40
