generator client {
  provider      = "prisma-client-js"
  output        = "../generated"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model AppSetting {
  settingId          Int      @id @default(autoincrement()) @map("setting_id")
  autoBackup         Boolean  @default(true) @map("auto_backup")
  backupFrequency    String   @default("daily") @map("backup_frequency") @db.VarChar(20)
  reportSendTime     DateTime @default(dbgenerated("'23:30:00'::time without time zone")) @map("report_send_time") @db.Time(6)
  reportSendTimezone String   @default("Asia/Phnom_Penh") @map("report_send_timezone") @db.VarChar(50)
  reportSendEnabled  Boolean  @default(true) @map("report_send_enabled")
  stockSyncPolicy    String   @default("allow_with_cached") @map("stock_sync_policy") @db.VarChar(50)
  updatedBy          Int      @map("updated_by")
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  backupScheduleTime DateTime @default(dbgenerated("'23:30:00'::time without time zone")) @map("backup_schedule_time") @db.Time(6)
  user               User     @relation(fields: [updatedBy], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@map("app_settings")
}

model AuditLog {
  logId      Int      @id @default(autoincrement()) @map("log_id")
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   Int?     @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user       User?    @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([action], map: "idx_audit_logs_action")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@index([userId], map: "idx_audit_logs_user_id")
  @@map("audit_logs")
}

model OrderItem {
  orderItemId       Int      @id @default(autoincrement()) @map("order_item_id")
  orderId           Int      @map("order_id")
  productId         Int      @map("product_id")
  productName       String   @map("product_name") @db.VarChar(200)
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(10, 2)
  costPerUnitAtSale Decimal  @map("cost_per_unit_at_sale") @db.Decimal(10, 2)
  cogsLineTotal     Decimal  @map("cogs_line_total") @db.Decimal(10, 2)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  subtotal          Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  order             Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)
  product           Product  @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([orderId, productId], map: "idx_order_items_order_product")
  @@index([productId], map: "idx_order_items_product_id")
  @@map("order_items")
}

model Order {
  orderId           Int               @id @default(autoincrement()) @map("order_id")
  receiptNumber     String            @unique(map: "idx_orders_receipt_number") @map("receipt_number") @db.VarChar(50)
  sellerId          Int               @map("seller_id")
  orderDate         DateTime          @default(now()) @map("order_date") @db.Timestamp(6)
  totalAmount       Decimal           @map("total_amount") @db.Decimal(10, 2)
  discountAmount    Decimal           @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount         Decimal           @default(0) @map("tax_amount") @db.Decimal(10, 2)
  serviceFee        Decimal           @default(0) @map("service_fee") @db.Decimal(10, 2)
  customerId        Int?              @map("customer_id")
  paidAmount        Decimal           @default(0) @map("paid_amount") @db.Decimal(10, 2)
  balanceDue        Decimal           @default(0) @map("balance_due") @db.Decimal(10, 2)
  paymentStatus     String            @default("PAID") @map("payment_status") @db.VarChar(20)
  paymentMethod     String            @default("CASH") @map("payment_method") @db.VarChar(20)
  paymentDueDate    DateTime?         @map("payment_due_date") @db.Timestamp(6)
  exchangeRate      Decimal           @default(4000) @map("exchange_rate") @db.Decimal(10, 2)
  orderStatus       String            @default("COMPLETED") @map("order_status") @db.VarChar(30)
  cancelReason      String?           @map("cancel_reason")
  cancelRequestedAt DateTime?         @map("cancel_requested_at") @db.Timestamp(6)
  cancelRequestedBy Int?              @map("cancel_requested_by")
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamp(6)
  cancelledBy       Int?              @map("cancelled_by")
  rejectionReason   String?           @map("rejection_reason")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime          @default(now()) @map("updated_at") @db.Timestamp(6)
  order_items       OrderItem[]
  order_payments    OrderPayment[]
  customer_payments CustomerPayment[]
  user              User              @relation(fields: [sellerId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  customer          Customer?         @relation(fields: [customerId], references: [customerId], onUpdate: NoAction)
  stock_movements   StockMovement[]
  receiptLink       ReceiptLink[]

  @@index([createdAt], map: "idx_orders_created_at")
  @@index([orderDate], map: "idx_orders_order_date")
  @@index([sellerId, orderDate], map: "idx_orders_seller_date")
  @@index([sellerId], map: "idx_orders_seller_id")
  @@index([customerId], map: "idx_orders_customer_id")
  @@index([paymentStatus], map: "idx_orders_payment_status")
  @@map("orders")
}

model OrderPayment {
  orderPaymentId Int      @id @default(autoincrement()) @map("order_payment_id")
  orderId        Int      @map("order_id")
  receivedAmount Decimal  @map("received_amount") @db.Decimal(10, 2)
  transactionId  String?  @map("transaction_id") @db.VarChar(255)
  paymentMethod  String?  @map("payment_method") @db.VarChar(50)
  receivedUsd    Decimal? @default(0) @map("received_usd") @db.Decimal(10, 2)
  receivedKhr    Decimal? @default(0) @map("received_khr") @db.Decimal(12, 2)
  changeUsd      Decimal? @default(0) @map("change_usd") @db.Decimal(10, 2)
  changeKhr      Decimal? @default(0) @map("change_khr") @db.Decimal(12, 2)
  slipUrl        String?  @map("slip_url") @db.VarChar(500)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  order          Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "idx_order_payments_order_id")
  @@index([createdAt], map: "idx_order_payments_created_at")
  @@map("order_payments")
}

model Product {
  productId            Int                 @id @default(autoincrement()) @map("product_id")
  productCode          String              @unique @map("product_code") @db.VarChar(50)
  productName          String              @map("product_name") @db.VarChar(200)
  barcode              String              @unique @db.VarChar(255)
  price                Decimal             @db.Decimal(10, 2)
  avgCost              Decimal?            @map("avg_cost") @db.Decimal(10, 2)
  lastPurchaseCost     Decimal?            @map("last_purchase_cost") @db.Decimal(10, 2)
  hasExpiry            Boolean             @default(false) @map("has_expiry")
  categoryId           Int?                @map("category_id")
  description          String?
  imagePath            String?             @map("image_path") @db.VarChar(500)
  lowStockThreshold    Int?                @map("low_stock_threshold")
  reorderPoint         Int                 @default(0) @map("reorder_point")
  status               String              @default("active") @db.VarChar(20)
  createdBy            Int                 @map("created_by")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedBy            Int                 @map("updated_by")
  updatedAt            DateTime            @default(now()) @map("updated_at") @db.Timestamp(6)
  deactivatedDate      DateTime?           @map("deactivated_date") @db.Timestamp(6)
  order_items          OrderItem[]
  createdByUser        User                @relation("products_created_byTousers", fields: [createdBy], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  updatedByUser        User                @relation("products_updated_byTousers", fields: [updatedBy], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  stock_lots           StockLot[]
  stock_movements      StockMovement[]
  stock                Stock?
  category             Category?           @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull, onUpdate: NoAction)
  purchase_order_items PurchaseOrderItem[]
  goods_received_items GoodsReceivedItem[]

  @@index([categoryId], map: "idx_products_category_id")
  @@index([hasExpiry], map: "idx_products_has_expiry")
  @@index([status], map: "idx_products_status")
  @@map("products")
}

model ReceiptSetting {
  settingId       Int      @id @default(autoincrement()) @map("setting_id")
  storeName       String   @map("store_name") @db.VarChar(200)
  logoPath        String?  @map("logo_path") @db.VarChar(500)
  phone           String?  @db.VarChar(30)
  address         String?
  taxId           String?  @map("tax_id") @db.VarChar(100)
  footerNote      String?  @map("footer_note")
  isLogoEnabled   Boolean  @default(true) @map("is_logo_enabled")
  isFooterEnabled Boolean  @default(true) @map("is_footer_enabled")
  updatedBy       Int?     @map("updated_by")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user            User?    @relation(fields: [updatedBy], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([storeName], map: "idx_receipt_settings_store_name")
  @@index([updatedAt], map: "idx_receipt_settings_updated_at")
  @@map("receipt_settings")
}

model RefreshToken {
  id                   Int            @id @default(autoincrement())
  userId               Int            @map("user_id")
  refreshTokenHash     String         @unique @map("refresh_token_hash") @db.VarChar(255)
  tokenFamilyId        String         @map("token_family_id") @db.Uuid
  parentTokenId        Int?           @map("parent_token_id")
  deviceId             String?        @map("device_id") @db.VarChar(255)
  absoluteExpiresAt    DateTime       @map("absolute_expires_at") @db.Timestamp(6)
  idleExpiresAt        DateTime       @map("idle_expires_at") @db.Timestamp(6)
  lastUsedAt           DateTime?      @map("last_used_at") @db.Timestamp(6)
  revokedAt            DateTime?      @map("revoked_at") @db.Timestamp(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  ipAddress            String?        @map("ip_address") @db.VarChar(45)
  userAgent            String?        @map("user_agent")
  parentToken          RefreshToken?  @relation("refresh_tokensTorefresh_tokens", fields: [parentTokenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_refresh_tokens RefreshToken[] @relation("refresh_tokensTorefresh_tokens")
  user                 User           @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([absoluteExpiresAt], map: "idx_refresh_tokens_absolute_expires_at")
  @@index([deviceId], map: "idx_refresh_tokens_device_id")
  @@index([tokenFamilyId], map: "idx_refresh_tokens_family_id")
  @@index([idleExpiresAt], map: "idx_refresh_tokens_idle_expires_at")
  @@index([revokedAt], map: "idx_refresh_tokens_revoked_at")
  @@index([userId, deviceId], map: "idx_refresh_tokens_user_device")
  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}

model StockLot {
  id              Int             @id @default(autoincrement())
  productId       Int             @map("product_id")
  qtyOnHand       Int             @map("qty_on_hand")
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamp(6)
  expiredAt       DateTime?       @map("expired_at") @db.Date
  cost            Decimal?        @db.Decimal(10, 2)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamp(6)
  product         Product         @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)
  stock_movements StockMovement[]

  @@index([productId, expiredAt], map: "idx_stock_lots_product_expired")
  @@index([productId, receivedAt], map: "idx_stock_lots_product_received")
  @@map("stock_lots")
}

model StockMovement {
  movementId   Int       @id @default(autoincrement()) @map("movement_id")
  productId    Int       @map("product_id")
  lotId        Int?      @map("lot_id")
  movementType String    @map("movement_type") @db.VarChar(20)
  quantity     Int
  cost         Decimal?  @db.Decimal(10, 2)
  price        Decimal?  @db.Decimal(10, 2)
  supplier     String?   @db.VarChar(200)
  reason       String?
  orderId      Int?      @map("order_id")
  createdBy    Int       @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  user         User      @relation(fields: [createdBy], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  stockLot     StockLot? @relation(fields: [lotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order        Order?    @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)
  product      Product   @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt], map: "idx_stock_movements_created_at")
  @@index([lotId], map: "idx_stock_movements_lot_id")
  @@index([orderId], map: "idx_stock_movements_order_id")
  @@index([productId, createdAt(sort: Desc)], map: "idx_stock_movements_product_created_at")
  @@index([productId], map: "idx_stock_movements_product_id")
  @@index([movementType], map: "idx_stock_movements_type")
  @@map("stock_movements")
}

model User {
  userId                              Int                @id @default(autoincrement()) @map("user_id")
  username                            String             @unique @db.VarChar(100)
  businessName                        String?            @map("business_name") @db.VarChar(200)
  address                             String?
  email                               String?            @db.VarChar(255)
  passwordHash                        String             @map("password_hash") @db.VarChar(255)
  pinHash                             String?            @map("pin_hash") @db.VarChar(255)
  fullName                            String             @map("full_name") @db.VarChar(200)
  role                                String             @db.VarChar(20)
  phone                               String?            @db.VarChar(20)
  status                              String             @default("active") @db.VarChar(20)
  deviceId                            String?            @map("device_id") @db.VarChar(255)
  bio                                 String?
  profileImage                        String?            @map("profile_image") @db.VarChar(500)
  createdBy                           Int?               @map("created_by")
  createdAt                           DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  endAt                               DateTime           @default(now()) @map("end_at") @db.Timestamp(6)
  updatedBy                           Int?               @map("updated_by")
  updatedAt                           DateTime           @default(now()) @map("updated_at") @db.Timestamp(6)
  deactivatedDate                     DateTime?          @map("deactivated_date") @db.Timestamp(6)
  app_settings                        AppSetting[]
  audit_logs                          AuditLog[]
  orders                              Order[]
  password_reset_otps                 PasswordResetOtp[]
  products_products_created_byTousers Product[]          @relation("products_created_byTousers")
  products_products_updated_byTousers Product[]          @relation("products_updated_byTousers")
  receipt_settings                    ReceiptSetting[]
  refresh_tokens                      RefreshToken[]
  stock_movements                     StockMovement[]
  user_permissions_granted            UserPermission[]   @relation("user_permissions_granted_byTousers")
  user_permissions                    UserPermission[]   @relation("user_permissions_user_idTousers")
  purchase_orders_approved_byTousers  PurchaseOrder[]    @relation("purchase_orders_approved_byTousers")
  purchase_orders_created_byTousers   PurchaseOrder[]    @relation("purchase_orders_created_byTousers")
  goods_received                      GoodsReceived[]
  supplier_payments                   SupplierPayment[]
  customer_payments                   CustomerPayment[]
  createdByUser                       User?              @relation("users_created_byTousers", fields: [createdBy], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  other_users_users_created_byTousers User[]             @relation("users_created_byTousers")
  updatedByUser                       User?              @relation("users_updated_byTousers", fields: [updatedBy], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  other_users_users_updated_byTousers User[]             @relation("users_updated_byTousers")

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@index([username], map: "idx_users_username")
  @@map("users")
}

model UserPermission {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  featureKey    String   @map("feature_key") @db.VarChar(100)
  actions       String   @default("read") @db.VarChar(255)
  grantedBy     Int?     @map("granted_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  grantedByUser User?    @relation("user_permissions_granted_byTousers", fields: [grantedBy], references: [userId], onDelete: SetNull, onUpdate: NoAction)
  user          User     @relation("user_permissions_user_idTousers", fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, featureKey], map: "uq_user_feature")
  @@index([userId], map: "idx_user_permissions_user_id")
  @@index([featureKey], map: "idx_user_permissions_feature_key")
  @@map("user_permissions")
}

model Stock {
  stockId      Int       @id @default(autoincrement()) @map("stock_id")
  productId    Int       @unique(map: "idx_stocks_product_id") @map("product_id")
  quantity     Int       @default(0)
  stockVersion Int       @default(1) @map("stock_version")
  lastSyncTime DateTime? @map("last_sync_time") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  product      Product   @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)

  @@index([stockVersion], map: "idx_stocks_version")
  @@map("stocks")
}

model Customer {
  customerId              Int                    @id @default(autoincrement()) @map("customer_id")
  deviceId                String?                @unique @map("device_id") @db.VarChar(255)
  fullName                String?                @map("full_name") @db.VarChar(255)
  phone                   String?                @db.VarChar(20)
  email                   String?                @db.VarChar(255)
  totalDebt               Decimal                @default(0.00) @map("total_debt") @db.Decimal(12, 2)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime               @default(now()) @map("updated_at") @db.Timestamp(6)
  customer_linking_tokens CustomerLinkingToken[]
  orders                  Order[]
  customer_payments       CustomerPayment[]

  @@map("customers")
}

model CustomerLinkingToken {
  token       String   @id @db.VarChar(64)
  customerId  Int      @map("customer_id")
  receiptCode String?  @map("receipt_code") @db.VarChar(255)
  expiresAt   DateTime @map("expires_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  customer    Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_linking_tokens_expires")
  @@map("customer_linking_tokens")
}

model BackupRun {
  runId                  Int       @id @default(autoincrement()) @map("run_id")
  triggeredBy            String    @map("triggered_by")
  runType                String    @map("run_type")
  backupName             String    @map("backup_name")
  schedule               String
  status                 String
  errorCode              String?   @map("error_code")
  errorMessage           String?   @map("error_message")
  objectKey              String?   @map("object_key")
  checksum               String?
  encryptionMethod       String?   @map("encryption_method")
  retentionPolicyApplied Boolean   @default(false) @map("retention_policy_applied")
  startedAt              DateTime  @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt            DateTime? @map("completed_at") @db.Timestamp(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([createdAt], map: "idx_backup_runs_created_at")
  @@index([status], map: "idx_backup_runs_status")
  @@map("backup_runs")
}

model Backup {
  backupId   Int      @id @default(autoincrement()) @map("backup_id")
  backupName String   @map("backup_name")
  objectKey  String   @map("object_key")
  fileSize   BigInt   @map("file_size")
  checksum   String
  status     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([createdAt], map: "idx_backups_created_at")
  @@index([status], map: "idx_backups_status")
  @@map("backups")
}

model PasswordResetOtp {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  otpCode   String    @map("otp_code") @db.VarChar(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, otpCode], map: "unique_active_otp_per_user")
  @@index([expiresAt], map: "idx_password_reset_otps_expires_at")
  @@index([userId], map: "idx_password_reset_otps_user_id")
  @@map("password_reset_otps")
}

model Category {
  categoryId  Int       @id @default(autoincrement()) @map("category_id")
  name        String    @unique @db.VarChar(100)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  products    Product[]

  @@map("categories")
}

model Supplier {
  supplierId        Int               @id @default(autoincrement()) @map("supplier_id")
  companyName       String            @map("company_name") @db.VarChar(255)
  contactPerson     String?           @map("contact_person") @db.VarChar(255)
  phone             String?           @db.VarChar(50)
  email             String?           @db.VarChar(255)
  address           String?
  taxId             String?           @map("tax_id") @db.VarChar(100)
  paymentTerms      String?           @default("NET_30") @map("payment_terms") @db.VarChar(100)
  totalDebt         Decimal           @default(0.00) @map("total_debt") @db.Decimal(12, 2)
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime          @default(now()) @map("updated_at") @db.Timestamp(6)
  goods_received    GoodsReceived[]
  purchase_orders   PurchaseOrder[]
  supplier_payments SupplierPayment[]

  @@index([companyName], map: "idx_suppliers_company_name")
  @@index([isActive], map: "idx_suppliers_is_active")
  @@map("suppliers")
}

model PurchaseOrder {
  poId                 Int                 @id @default(autoincrement()) @map("po_id")
  poNumber             String              @unique(map: "idx_purchase_orders_po_number") @map("po_number") @db.VarChar(50)
  supplierId           Int                 @map("supplier_id")
  status               String              @default("DRAFT") @db.VarChar(50)
  orderDate            DateTime            @default(now()) @map("order_date") @db.Timestamp(6)
  expectedDeliveryDate DateTime?           @map("expected_delivery_date") @db.Timestamp(6)
  subtotal             Decimal             @default(0.00) @db.Decimal(12, 2)
  taxAmount            Decimal             @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount       Decimal             @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount          Decimal             @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  paidAmount           Decimal             @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  balanceDue           Decimal             @default(0.00) @map("balance_due") @db.Decimal(12, 2)
  paymentStatus        String              @default("UNPAID") @map("payment_status") @db.VarChar(50)
  paymentMethod        String?             @map("payment_method") @db.VarChar(50)
  paymentDueDate       DateTime?           @map("payment_due_date") @db.Timestamp(6)
  notes                String?
  createdBy            Int                 @map("created_by")
  approvedBy           Int?                @map("approved_by")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime            @default(now()) @map("updated_at") @db.Timestamp(6)
  goods_received       GoodsReceived[]
  purchase_order_items PurchaseOrderItem[]
  supplier_payments    SupplierPayment[]
  approvedByUser       User?               @relation("purchase_orders_approved_byTousers", fields: [approvedBy], references: [userId], onUpdate: NoAction)
  createdByUser        User                @relation("purchase_orders_created_byTousers", fields: [createdBy], references: [userId], onUpdate: NoAction)
  supplier             Supplier            @relation(fields: [supplierId], references: [supplierId], onUpdate: NoAction)

  @@index([orderDate], map: "idx_purchase_orders_order_date")
  @@index([status], map: "idx_purchase_orders_status")
  @@index([paymentStatus], map: "idx_purchase_orders_payment_status")
  @@index([paymentDueDate], map: "idx_purchase_orders_payment_due_date")
  @@index([supplierId], map: "idx_purchase_orders_supplier_id")
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  poItemId             Int                 @id @default(autoincrement()) @map("po_item_id")
  poId                 Int                 @map("po_id")
  productId            Int                 @map("product_id")
  orderedQuantity      Int                 @map("ordered_quantity")
  receivedQuantity     Int                 @default(0) @map("received_quantity")
  unitCost             Decimal             @default(0.00) @map("unit_cost") @db.Decimal(12, 2)
  subtotal             Decimal             @default(0.00) @db.Decimal(12, 2)
  notes                String?             @db.VarChar(255)
  goods_received_items GoodsReceivedItem[]
  purchaseOrder        PurchaseOrder       @relation(fields: [poId], references: [poId], onDelete: Cascade, onUpdate: NoAction)
  product              Product             @relation(fields: [productId], references: [productId], onUpdate: NoAction)

  @@index([poId], map: "idx_purchase_order_items_po_id")
  @@index([productId], map: "idx_purchase_order_items_product_id")
  @@map("purchase_order_items")
}

model GoodsReceived {
  grId                 Int                 @id @default(autoincrement()) @map("gr_id")
  grNumber             String              @unique @map("gr_number") @db.VarChar(50)
  poId                 Int?                @map("po_id")
  supplierId           Int                 @map("supplier_id")
  receivedDate         DateTime            @default(now()) @map("received_date") @db.Timestamp(6)
  invoiceNumber        String?             @map("invoice_number") @db.VarChar(100)
  totalReceivedAmount  Decimal             @default(0.00) @map("total_received_amount") @db.Decimal(12, 2)
  notes                String?
  receivedBy           Int                 @map("received_by")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  purchaseOrder        PurchaseOrder?      @relation(fields: [poId], references: [poId], onUpdate: NoAction)
  user                 User                @relation(fields: [receivedBy], references: [userId], onUpdate: NoAction)
  supplier             Supplier            @relation(fields: [supplierId], references: [supplierId], onUpdate: NoAction)
  goods_received_items GoodsReceivedItem[]

  @@index([poId], map: "idx_goods_received_po_id")
  @@index([receivedDate], map: "idx_goods_received_received_date")
  @@index([supplierId], map: "idx_goods_received_supplier_id")
  @@map("goods_received")
}

model GoodsReceivedItem {
  grItemId          Int                @id @default(autoincrement()) @map("gr_item_id")
  grId              Int                @map("gr_id")
  poItemId          Int?               @map("po_item_id")
  productId         Int                @map("product_id")
  quantityReceived  Int                @map("quantity_received")
  unitCost          Decimal            @default(0.00) @map("unit_cost") @db.Decimal(12, 2)
  batchNumber       String?            @map("batch_number") @db.VarChar(100)
  expiryDate        DateTime?          @map("expiry_date") @db.Timestamp(6)
  subtotal          Decimal            @default(0.00) @db.Decimal(12, 2)
  goodsReceived     GoodsReceived      @relation(fields: [grId], references: [grId], onDelete: Cascade, onUpdate: NoAction)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [poItemId], references: [poItemId], onUpdate: NoAction)
  product           Product            @relation(fields: [productId], references: [productId], onUpdate: NoAction)

  @@index([grId], map: "idx_goods_received_items_gr_id")
  @@index([poItemId], map: "idx_goods_received_items_po_item_id")
  @@index([productId], map: "idx_goods_received_items_product_id")
  @@map("goods_received_items")
}

model Role {
  roleId           Int              @id @default(autoincrement()) @map("role_id")
  key              String           @unique @db.VarChar(50)
  name             String           @db.VarChar(100)
  description      String?          @db.VarChar(255)
  isSystem         Boolean          @default(false) @map("is_system")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamp(6)
  role_permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id         Int      @id @default(autoincrement())
  roleId     Int      @map("role_id")
  featureKey String   @map("feature_key") @db.VarChar(100)
  actions    String   @default("read") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  role       Role     @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@unique([roleId, featureKey], map: "uq_role_feature")
  @@index([roleId], map: "idx_role_permissions_role_id")
  @@map("role_permissions")
}

model SupplierPayment {
  paymentId       Int            @id @default(autoincrement()) @map("payment_id")
  paymentNumber   String         @unique(map: "idx_supplier_payments_payment_number") @map("payment_number") @db.VarChar(50)
  supplierId      Int            @map("supplier_id")
  poId            Int?           @map("po_id")
  amount          Decimal        @default(0.00) @db.Decimal(12, 2)
  paymentMethod   String         @map("payment_method") @db.VarChar(50)
  referenceNumber String?        @map("reference_number") @db.VarChar(100)
  paymentDate     DateTime       @default(now()) @map("payment_date") @db.Timestamp(6)
  notes           String?
  createdBy       Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  user            User           @relation(fields: [createdBy], references: [userId], onUpdate: NoAction)
  supplier        Supplier       @relation(fields: [supplierId], references: [supplierId], onUpdate: NoAction)
  purchaseOrder   PurchaseOrder? @relation(fields: [poId], references: [poId], onUpdate: NoAction)

  @@index([supplierId], map: "idx_supplier_payments_supplier_id")
  @@index([poId], map: "idx_supplier_payments_po_id")
  @@index([paymentDate], map: "idx_supplier_payments_payment_date")
  @@map("supplier_payments")
}

model CustomerPayment {
  paymentId       Int      @id @default(autoincrement()) @map("payment_id")
  paymentNumber   String   @unique(map: "idx_customer_payments_payment_number") @map("payment_number") @db.VarChar(50)
  customerId      Int      @map("customer_id")
  orderId         Int?     @map("order_id")
  amount          Decimal  @default(0.00) @db.Decimal(12, 2)
  paymentMethod   String   @map("payment_method") @db.VarChar(50)
  referenceNumber String?  @map("reference_number") @db.VarChar(100)
  paymentDate     DateTime @default(now()) @map("payment_date") @db.Timestamp(6)
  notes           String?
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user            User     @relation(fields: [createdBy], references: [userId], onUpdate: NoAction)
  customer        Customer @relation(fields: [customerId], references: [customerId], onUpdate: NoAction)
  order           Order?   @relation(fields: [orderId], references: [orderId], onUpdate: NoAction)

  @@index([customerId], map: "idx_customer_payments_customer_id")
  @@index([orderId], map: "idx_customer_payments_order_id")
  @@index([paymentDate], map: "idx_customer_payments_payment_date")
  @@map("customer_payments")
}

model ReceiptLink {
  receiptLinkId    Int       @id @default(autoincrement()) @map("receipt_link_id")
  orderId          Int       @map("order_id")
  code             String    @unique @db.VarChar(100)
  linkStatus       String    @default("PENDING") @map("link_status") @db.VarChar(20)
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt           DateTime? @map("used_at") @db.Timestamp(6)
  telegramUserId   BigInt?   @map("telegram_user_id")
  telegramChatId   BigInt?   @map("telegram_chat_id")
  telegramUsername String?   @map("telegram_username") @db.VarChar(255)
  createdBy        Int       @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)

  @@map("receipt_links")
}
