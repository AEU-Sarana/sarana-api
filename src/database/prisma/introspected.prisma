generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model app_settings {
  setting_id             Int      @id @default(autoincrement())
  auto_backup            Boolean  @default(true)
  backup_frequency       String   @default("daily") @db.VarChar(20)
  report_send_time       DateTime @default(dbgenerated("'23:30:00'::time without time zone")) @db.Time(6)
  report_send_timezone   String   @default("Asia/Phnom_Penh") @db.VarChar(50)
  report_send_enabled    Boolean  @default(true)
  stock_sync_policy      String   @default("allow_with_cached") @db.VarChar(50)
  updated_by             Int
  updated_at             DateTime @default(now()) @db.Timestamp(6)
  created_at             DateTime @default(now()) @db.Timestamp(6)
  backup_schedule_time   DateTime @default(dbgenerated("'23:30:00'::time without time zone")) @db.Time(6)
  users                  users    @relation(fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model audit_logs {
  log_id      Int      @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(50)
  entity_id   Int?
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.VarChar(45)
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  users       users?   @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([action], map: "idx_audit_logs_action")
  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([user_id], map: "idx_audit_logs_user_id")
}

model order_items {
  order_item_id         Int      @id @default(autoincrement())
  order_id              Int
  product_id            Int
  product_name          String   @db.VarChar(200)
  quantity              Int
  unit_price            Decimal  @db.Decimal(10, 2)
  cost_per_unit_at_sale Decimal  @db.Decimal(10, 2)
  cogs_line_total       Decimal  @db.Decimal(10, 2)
  discount_amount       Decimal  @default(0) @db.Decimal(10, 2)
  subtotal              Decimal  @db.Decimal(10, 2)
  created_at            DateTime @default(now()) @db.Timestamp(6)
  orders                orders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  products              products @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_items_order_id")
  @@index([order_id, product_id], map: "idx_order_items_order_product")
  @@index([product_id], map: "idx_order_items_product_id")
}

model orders {
  order_id           Int                  @id @default(autoincrement())
  receipt_number     String               @unique(map: "idx_orders_receipt_number") @db.VarChar(50)
  seller_id          Int
  order_date         DateTime             @default(now()) @db.Timestamp(6)
  total_amount       Decimal              @db.Decimal(10, 2)
  discount_amount    Decimal              @default(0) @db.Decimal(10, 2)
  tax_amount         Decimal              @default(0) @db.Decimal(10, 2)
  service_fee        Decimal              @default(0) @db.Decimal(10, 2)
  payment_method     String               @default("CASH") @db.VarChar(20)
  exchange_rate      Decimal              @default(4000) @db.Decimal(10, 2)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  order_items        order_items[]
  order_payments     order_payments[]
  users              users                @relation(fields: [seller_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  receipt_deliveries receipt_deliveries[]
  receipt_links      receipt_links[]
  stock_movements    stock_movements[]

  @@index([created_at], map: "idx_orders_created_at")
  @@index([order_date], map: "idx_orders_order_date")
  @@index([seller_id, order_date], map: "idx_orders_seller_date")
  @@index([seller_id], map: "idx_orders_seller_id")
}

model order_payments {
  order_payment_id Int      @id @default(autoincrement())
  order_id         Int
  received_amount  Decimal  @db.Decimal(10, 2)
  transaction_id   String?  @db.VarChar(255)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  orders           orders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_payments_order_id")
  @@index([created_at], map: "idx_order_payments_created_at")
}

model products {
  product_id                       Int               @id @default(autoincrement())
  product_code                     String            @unique @db.VarChar(50)
  product_name                     String            @db.VarChar(200)
  barcode                          String            @unique @db.VarChar(255)
  price                            Decimal           @db.Decimal(10, 2)
  avg_cost                         Decimal?          @db.Decimal(10, 2)
  last_purchase_cost               Decimal?          @db.Decimal(10, 2)
  has_expiry                       Boolean           @default(false)
  category_id                      Int?
  description                      String?
  image_path                       String?           @db.VarChar(500)
  low_stock_threshold              Int?
  reorder_point                    Int               @default(0)
  status                           String            @default("active") @db.VarChar(20)
  created_by                       Int
  created_at                       DateTime          @default(now()) @db.Timestamp(6)
  updated_by                       Int
  updated_at                       DateTime          @default(now()) @db.Timestamp(6)
  deactivated_date                 DateTime?         @db.Timestamp(6)
  order_items                      order_items[]
  users_products_created_byTousers users             @relation("products_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_products_updated_byTousers users             @relation("products_updated_byTousers", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  stock_lots                       stock_lots[]
  stock_movements                  stock_movements[]
  stocks                           stocks?
  categories                       categories?       @relation(fields: [category_id], references: [category_id], onDelete: SetNull, onUpdate: NoAction)
  purchase_order_items             purchase_order_items[]
  goods_received_items             goods_received_items[]

  @@index([category_id], map: "idx_products_category_id")
  @@index([has_expiry], map: "idx_products_has_expiry")
  @@index([status], map: "idx_products_status")
}

model receipt_links {
  receipt_link_id    Int                  @id @default(autoincrement())
  order_id           Int
  code               String               @unique(map: "idx_receipt_links_code") @db.VarChar(100)
  link_status        String               @default("PENDING") @db.VarChar(20)
  expires_at         DateTime             @db.Timestamp(6)
  used_at            DateTime?            @db.Timestamp(6)
  telegram_user_id   BigInt?
  telegram_chat_id   BigInt?
  telegram_username  String?              @db.VarChar(255)
  created_by         Int
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  receipt_deliveries receipt_deliveries[]
  users              users                @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  orders             orders               @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_receipt_links_created_at")
  @@index([expires_at], map: "idx_receipt_links_expires_at")
  @@index([order_id], map: "idx_receipt_links_order_id")
  @@index([link_status], map: "idx_receipt_links_status")
  @@index([telegram_user_id], map: "idx_receipt_links_telegram_user_id")
}

model receipt_settings {
  setting_id        Int      @id @default(autoincrement())
  store_name        String   @db.VarChar(200)
  logo_path         String?  @db.VarChar(500)
  phone             String?  @db.VarChar(30)
  address           String?
  tax_id            String?  @db.VarChar(100)
  footer_note       String?
  is_logo_enabled   Boolean  @default(true)
  is_footer_enabled Boolean  @default(true)
  updated_by        Int?
  updated_at        DateTime @default(now()) @db.Timestamp(6)
  created_at        DateTime @default(now()) @db.Timestamp(6)
  users             users?   @relation(fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([store_name], map: "idx_receipt_settings_store_name")
  @@index([updated_at], map: "idx_receipt_settings_updated_at")
}

model refresh_tokens {
  id                   Int              @id @default(autoincrement())
  user_id              Int
  refresh_token_hash   String           @unique @db.VarChar(255)
  token_family_id      String           @db.Uuid
  parent_token_id      Int?
  device_id            String?          @db.VarChar(255)
  absolute_expires_at  DateTime         @db.Timestamp(6)
  idle_expires_at      DateTime         @db.Timestamp(6)
  last_used_at         DateTime?        @db.Timestamp(6)
  revoked_at           DateTime?        @db.Timestamp(6)
  created_at           DateTime         @default(now()) @db.Timestamp(6)
  ip_address           String?          @db.VarChar(45)
  user_agent           String?
  refresh_tokens       refresh_tokens?  @relation("refresh_tokensTorefresh_tokens", fields: [parent_token_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_refresh_tokens refresh_tokens[] @relation("refresh_tokensTorefresh_tokens")
  users                users            @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([absolute_expires_at], map: "idx_refresh_tokens_absolute_expires_at")
  @@index([device_id], map: "idx_refresh_tokens_device_id")
  @@index([token_family_id], map: "idx_refresh_tokens_family_id")
  @@index([idle_expires_at], map: "idx_refresh_tokens_idle_expires_at")
  @@index([revoked_at], map: "idx_refresh_tokens_revoked_at")
  @@index([user_id, device_id], map: "idx_refresh_tokens_user_device")
  @@index([user_id], map: "idx_refresh_tokens_user_id")
}

model stock_lots {
  id              Int               @id @default(autoincrement())
  product_id      Int
  qty_on_hand     Int
  received_at     DateTime          @default(now()) @db.Timestamp(6)
  expired_at      DateTime?         @db.Date
  cost            Decimal?          @db.Decimal(10, 2)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  products        products          @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
  stock_movements stock_movements[]

  @@index([product_id, expired_at], map: "idx_stock_lots_product_expired")
  @@index([product_id, received_at], map: "idx_stock_lots_product_received")
}

model stock_movements {
  movement_id   Int         @id @default(autoincrement())
  product_id    Int
  lot_id        Int?
  movement_type String      @db.VarChar(20)
  quantity      Int
  cost          Decimal?    @db.Decimal(10, 2)
  price         Decimal?    @db.Decimal(10, 2)
  supplier      String?     @db.VarChar(200)
  reason        String?
  order_id      Int?
  created_by    Int
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  users         users       @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  stock_lots    stock_lots? @relation(fields: [lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders        orders?     @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  products      products    @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_stock_movements_created_at")
  @@index([lot_id], map: "idx_stock_movements_lot_id")
  @@index([order_id], map: "idx_stock_movements_order_id")
  @@index([product_id, created_at(sort: Desc)], map: "idx_stock_movements_product_created_at")
  @@index([product_id], map: "idx_stock_movements_product_id")
  @@index([movement_type], map: "idx_stock_movements_type")
}

model telegram_admin_links {
  id               Int       @id @default(autoincrement())
  user_id          Int
  telegram_user_id BigInt    @unique
  chat_id          BigInt
  status           String    @default("ACTIVE") @db.VarChar(10)
  linked_at        DateTime  @default(now()) @db.Timestamp(6)
  revoked_at       DateTime? @db.Timestamp(6)
  last_seen_at     DateTime? @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model telegram_admin_messages {
  id               Int      @id @default(autoincrement())
  telegram_user_id BigInt
  command          String
  request_id       String?  @db.Uuid
  status           String   @default("SENT") @db.VarChar(10)
  message_id       BigInt?
  error_message    String?
  created_at       DateTime @default(now()) @db.Timestamp(6)

  @@index([request_id], map: "idx_telegram_admin_messages_request")
  @@index([telegram_user_id], map: "idx_telegram_admin_messages_user")
}

model telegram_config {
  config_id                               Int       @id @default(autoincrement())
  bot_token                               String
  group_chat_id                           String    @db.VarChar(255)
  is_active                               Boolean   @default(true)
  last_test_time                          DateTime? @db.Timestamp(6)
  last_test_status                        String?   @db.VarChar(20)
  created_by                              Int
  created_at                              DateTime  @default(now()) @db.Timestamp(6)
  updated_by                              Int
  updated_at                              DateTime  @default(now()) @db.Timestamp(6)
  users_telegram_config_created_byTousers users     @relation("telegram_config_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_telegram_config_updated_byTousers users     @relation("telegram_config_updated_byTousers", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  user_id                                           Int                    @id @default(autoincrement())
  username                                          String                 @unique @db.VarChar(100)
  business_name                                     String?                @db.VarChar(200)
  address                                           String?
  email                                             String?                @db.VarChar(255)
  password_hash                                     String                 @db.VarChar(255)
  pin_hash                                          String?                @db.VarChar(255)
  full_name                                         String                 @db.VarChar(200)
  role                                              String                 @db.VarChar(20)
  phone                                             String?                @db.VarChar(20)
  status                                            String                 @default("active") @db.VarChar(20)
  device_id                                         String?                @db.VarChar(255)
  bio                                               String?
  profile_image                                     String?                @db.VarChar(500)
  created_by                                        Int?
  created_at                                        DateTime               @default(now()) @db.Timestamp(6)
  end_at                                            DateTime               @default(now()) @db.Timestamp(6)
  updated_by                                        Int?
  updated_at                                        DateTime               @default(now()) @db.Timestamp(6)
  deactivated_date                                  DateTime?              @db.Timestamp(6)
  app_settings                                      app_settings[]
  audit_logs                                        audit_logs[]
  orders                                            orders[]
  password_reset_otps                               password_reset_otps[]
  products_products_created_byTousers               products[]             @relation("products_created_byTousers")
  products_products_updated_byTousers               products[]             @relation("products_updated_byTousers")
  receipt_links                                     receipt_links[]
  receipt_settings                                  receipt_settings[]
  refresh_tokens                                    refresh_tokens[]
  stock_movements                                   stock_movements[]
  telegram_admin_links                              telegram_admin_links[]
  telegram_config_telegram_config_created_byTousers telegram_config[]      @relation("telegram_config_created_byTousers")
  telegram_config_telegram_config_updated_byTousers telegram_config[]      @relation("telegram_config_updated_byTousers")
  user_permissions_granted                         user_permissions[]     @relation("user_permissions_granted_byTousers")
  user_permissions                                  user_permissions[]     @relation("user_permissions_user_idTousers")
  purchase_orders_approved_byTousers               purchase_orders[]      @relation("purchase_orders_approved_byTousers")
  purchase_orders_created_byTousers                purchase_orders[]      @relation("purchase_orders_created_byTousers")
  goods_received                                   goods_received[]
  users_users_created_byTousers                     users?                 @relation("users_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  other_users_users_created_byTousers               users[]                @relation("users_created_byTousers")
  users_users_updated_byTousers                     users?                 @relation("users_updated_byTousers", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  other_users_users_updated_byTousers               users[]                @relation("users_updated_byTousers")

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@index([username], map: "idx_users_username")
}

model user_permissions {
  id                                            Int      @id @default(autoincrement())
  user_id                                       Int
  feature_key                                   String   @db.VarChar(100)
  actions                                       String   @default("read") @db.VarChar(255)
  granted_by                                    Int?
  created_at                                    DateTime @default(now()) @db.Timestamp(6)
  users_granted_by                              users?   @relation("user_permissions_granted_byTousers", fields: [granted_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  users_user_id                                 users    @relation("user_permissions_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, feature_key], map: "uq_user_feature")
  @@index([user_id], map: "idx_user_permissions_user_id")
  @@index([feature_key], map: "idx_user_permissions_feature_key")
}


model stocks {
  stock_id       Int       @id @default(autoincrement())
  product_id     Int       @unique(map: "idx_stocks_product_id")
  quantity       Int       @default(0)
  stock_version  Int       @default(1)
  last_sync_time DateTime? @db.Timestamp(6)
  updated_at     DateTime  @default(now()) @db.Timestamp(6)
  products       products  @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([stock_version], map: "idx_stocks_version")
}

model customer_telegram_links {
  id               Int       @id @default(autoincrement())
  customer_id      Int       @unique
  telegram_chat_id BigInt
  telegram_user_id BigInt?
  linked_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @db.Timestamp(6)
  customers        customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)
}

model customers {
  customer_id             Int                       @id @default(autoincrement())
  device_id               String?                   @unique @db.VarChar(255)
  full_name               String?                   @db.VarChar(255)
  phone                   String?                   @db.VarChar(20)
  email                   String?                   @db.VarChar(255)
  created_at              DateTime                  @default(now()) @db.Timestamp(6)
  updated_at              DateTime                  @default(now()) @db.Timestamp(6)
  customer_linking_tokens customer_linking_tokens[]
  customer_telegram_links customer_telegram_links?
}

model receipt_deliveries {
  id                  Int            @id @default(autoincrement())
  order_id            Int
  telegram_chat_id    BigInt
  status              String         @db.VarChar(20)
  sent_at             DateTime?      @db.Timestamp(6)
  receipt_link_id     Int?
  receipt_code        String?        @db.VarChar(255)
  telegram_message_id BigInt?
  error_code          Int?
  error_message       String?        @db.VarChar(500)
  last_attempt_at     DateTime       @default(now()) @db.Timestamp(6)
  created_at          DateTime       @default(now()) @db.Timestamp(6)
  updated_at          DateTime       @default(now()) @db.Timestamp(6)
  orders              orders         @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  receipt_links       receipt_links? @relation(fields: [receipt_link_id], references: [receipt_link_id], onUpdate: NoAction)

  @@unique([receipt_link_id, telegram_chat_id], map: "uq_receipt_deliveries_link_chat")
  @@index([telegram_chat_id], map: "idx_receipt_deliveries_telegram_chat_id")
  @@index([receipt_link_id], map: "idx_receipt_deliveries_link_id")
  @@index([receipt_link_id, telegram_chat_id], map: "idx_receipt_deliveries_link_chat")
}

model customer_linking_tokens {
  token        String    @id @db.VarChar(64)
  customer_id  Int
  receipt_code String?   @db.VarChar(255)
  expires_at   DateTime  @db.Timestamp(6)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  customers    customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_linking_tokens_expires")
}

model backup_runs {
  run_id                   Int       @id @default(autoincrement())
  triggered_by             String
  run_type                 String
  backup_name              String
  schedule                 String
  status                   String
  error_code               String?
  error_message            String?
  object_key               String?
  checksum                 String?
  encryption_method        String?
  retention_policy_applied Boolean   @default(false)
  started_at               DateTime  @default(now()) @db.Timestamp(6)
  completed_at             DateTime? @db.Timestamp(6)
  created_at               DateTime  @default(now()) @db.Timestamp(6)

  @@index([created_at], map: "idx_backup_runs_created_at")
  @@index([status], map: "idx_backup_runs_status")
}

model backups {
  backup_id   Int      @id @default(autoincrement())
  backup_name String
  object_key  String
  file_size   BigInt
  checksum    String
  status      String
  created_at  DateTime @default(now()) @db.Timestamp(6)

  @@index([created_at], map: "idx_backups_created_at")
  @@index([status], map: "idx_backups_status")
}



model password_reset_otps {
  id         Int       @id @default(autoincrement())
  user_id    Int
  otp_code   String    @db.VarChar(6)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, otp_code], map: "unique_active_otp_per_user")
  @@index([expires_at], map: "idx_password_reset_otps_expires_at")
  @@index([user_id], map: "idx_password_reset_otps_user_id")
}

model categories {
  category_id Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  description String?
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @default(now()) @db.Timestamp(6)
  products    products[]
}

model suppliers {
  supplier_id     Int               @id @default(autoincrement())
  company_name    String            @db.VarChar(255)
  contact_person  String?           @db.VarChar(255)
  phone           String?           @db.VarChar(50)
  email           String?           @db.VarChar(255)
  address         String?
  tax_id          String?           @db.VarChar(100)
  payment_terms   String?           @default("NET_30") @db.VarChar(100)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  goods_received  goods_received[]
  purchase_orders purchase_orders[]

  @@index([company_name], map: "idx_suppliers_company_name")
  @@index([is_active], map: "idx_suppliers_is_active")
}

model purchase_orders {
  po_id                                    Int                    @id @default(autoincrement())
  po_number                                String                 @unique(map: "idx_purchase_orders_po_number") @db.VarChar(50)
  supplier_id                              Int
  status                                   String                 @default("DRAFT") @db.VarChar(50)
  order_date                               DateTime               @default(now()) @db.Timestamp(6)
  expected_delivery_date                   DateTime?              @db.Timestamp(6)
  subtotal                                 Decimal                @default(0.00) @db.Decimal(12, 2)
  tax_amount                               Decimal                @default(0.00) @db.Decimal(12, 2)
  discount_amount                          Decimal                @default(0.00) @db.Decimal(12, 2)
  total_amount                             Decimal                @default(0.00) @db.Decimal(12, 2)
  notes                                    String?
  created_by                               Int
  approved_by                              Int?
  created_at                               DateTime               @default(now()) @db.Timestamp(6)
  updated_at                               DateTime               @default(now()) @db.Timestamp(6)
  goods_received                           goods_received[]
  purchase_order_items                     purchase_order_items[]
  users_purchase_orders_approved_byTousers users?                 @relation("purchase_orders_approved_byTousers", fields: [approved_by], references: [user_id], onUpdate: NoAction)
  users_purchase_orders_created_byTousers  users                  @relation("purchase_orders_created_byTousers", fields: [created_by], references: [user_id], onUpdate: NoAction)
  suppliers                                suppliers              @relation(fields: [supplier_id], references: [supplier_id], onUpdate: NoAction)

  @@index([order_date], map: "idx_purchase_orders_order_date")
  @@index([status], map: "idx_purchase_orders_status")
  @@index([supplier_id], map: "idx_purchase_orders_supplier_id")
}

model purchase_order_items {
  po_item_id           Int                    @id @default(autoincrement())
  po_id                Int
  product_id           Int
  ordered_quantity     Int
  received_quantity    Int                    @default(0)
  unit_cost            Decimal                @default(0.00) @db.Decimal(12, 2)
  subtotal             Decimal                @default(0.00) @db.Decimal(12, 2)
  notes                String?                @db.VarChar(255)
  goods_received_items goods_received_items[]
  purchase_orders      purchase_orders        @relation(fields: [po_id], references: [po_id], onDelete: Cascade, onUpdate: NoAction)
  products             products               @relation(fields: [product_id], references: [product_id], onUpdate: NoAction)

  @@index([po_id], map: "idx_purchase_order_items_po_id")
  @@index([product_id], map: "idx_purchase_order_items_product_id")
}

model goods_received {
  gr_id                 Int                    @id @default(autoincrement())
  gr_number             String                 @unique @db.VarChar(50)
  po_id                 Int?
  supplier_id           Int
  received_date         DateTime               @default(now()) @db.Timestamp(6)
  invoice_number        String?                @db.VarChar(100)
  total_received_amount Decimal                @default(0.00) @db.Decimal(12, 2)
  notes                 String?
  received_by           Int
  created_at            DateTime               @default(now()) @db.Timestamp(6)
  purchase_orders       purchase_orders?       @relation(fields: [po_id], references: [po_id], onUpdate: NoAction)
  users                 users                  @relation(fields: [received_by], references: [user_id], onUpdate: NoAction)
  suppliers             suppliers              @relation(fields: [supplier_id], references: [supplier_id], onUpdate: NoAction)
  goods_received_items  goods_received_items[]

  @@index([po_id], map: "idx_goods_received_po_id")
  @@index([received_date], map: "idx_goods_received_received_date")
  @@index([supplier_id], map: "idx_goods_received_supplier_id")
}

model goods_received_items {
  gr_item_id           Int                   @id @default(autoincrement())
  gr_id                Int
  po_item_id           Int?
  product_id           Int
  quantity_received    Int
  unit_cost            Decimal               @default(0.00) @db.Decimal(12, 2)
  batch_number         String?               @db.VarChar(100)
  expiry_date          DateTime?             @db.Timestamp(6)
  subtotal             Decimal               @default(0.00) @db.Decimal(12, 2)
  goods_received       goods_received        @relation(fields: [gr_id], references: [gr_id], onDelete: Cascade, onUpdate: NoAction)
  purchase_order_items purchase_order_items? @relation(fields: [po_item_id], references: [po_item_id], onUpdate: NoAction)
  products             products              @relation(fields: [product_id], references: [product_id], onUpdate: NoAction)

  @@index([gr_id], map: "idx_goods_received_items_gr_id")
  @@index([po_item_id], map: "idx_goods_received_items_po_item_id")
  @@index([product_id], map: "idx_goods_received_items_product_id")
}

model roles {
  role_id          Int                @id @default(autoincrement())
  key              String             @unique @db.VarChar(50)
  name             String             @db.VarChar(100)
  description      String?            @db.VarChar(255)
  is_system        Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @default(now()) @db.Timestamp(6)
  role_permissions role_permissions[]
}

model role_permissions {
  id          Int      @id @default(autoincrement())
  role_id     Int
  feature_key String   @db.VarChar(100)
  actions     String   @default("read") @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  roles       roles    @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@unique([role_id, feature_key], map: "uq_role_feature")
  @@index([role_id], map: "idx_role_permissions_role_id")
}


