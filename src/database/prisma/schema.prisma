generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId                 Int              @id @default(autoincrement()) @map("user_id")
  username               String           @unique @db.VarChar(100)
  email                  String?          @db.VarChar(255)
  passwordHash           String           @map("password_hash") @db.VarChar(255)
  pinHash                String?          @map("pin_hash") @db.VarChar(255)
  fullName               String           @map("full_name") @db.VarChar(200)
  role                   String           @db.VarChar(20)
  phone                  String?          @db.VarChar(20)
  status                 String           @default("active") @db.VarChar(20)
  deviceId               String?          @map("device_id") @db.VarChar(255)
  isDeviceBound          Boolean          @default(false) @map("is_device_bound")
  createdBy              Int?             @map("created_by")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedBy              Int?             @map("updated_by")
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at")
  deactivatedDate        DateTime?        @map("deactivated_date")
  settingsUpdated        AppSetting[]
  auditLogs              AuditLog[]
  deviceBindingsApproved DeviceBinding[]  @relation("DeviceBindingApprovedBy")
  deviceBindings         DeviceBinding[]
  orders                 Order[]
  productsCreated        Product[]        @relation("ProductCreatedBy")
  productsUpdated        Product[]        @relation("ProductUpdatedBy")
  shifts                 Shift[]
  stockMovements         StockMovement[]
  telegramConfigCreated  TelegramConfig[] @relation("TelegramConfigCreatedBy")
  telegramConfigUpdated  TelegramConfig[] @relation("TelegramConfigUpdatedBy")
  telegramAdminLinks     TelegramAdminLinks[]
  creator                User?            @relation("UserCreatedBy", fields: [createdBy], references: [userId])
  createdUsers           User[]           @relation("UserCreatedBy")
  updater                User?            @relation("UserUpdatedBy", fields: [updatedBy], references: [userId])
  updatedUsers           User[]           @relation("UserUpdatedBy")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([username])
  @@map("users")
}

model Product {
  productId         Int             @id @default(autoincrement()) @map("product_id")
  productCode       String          @unique @map("product_code") @db.VarChar(50)
  productName       String          @map("product_name") @db.VarChar(200)
  barcode           String          @unique @map("barcode") @db.VarChar(255)
  price             Decimal         @db.Decimal(10, 2)
  category          String?         @db.VarChar(100)
  description       String?
  imagePath         String?         @map("image_path") @db.VarChar(500)
  lowStockThreshold Int?            @map("low_stock_threshold")
  status            String          @default("active") @db.VarChar(20)
  createdBy         Int             @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedBy         Int             @map("updated_by")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")
  deactivatedDate   DateTime?       @map("deactivated_date")
  orderItems        OrderItem[]
  creator           User            @relation("ProductCreatedBy", fields: [createdBy], references: [userId])
  updater           User            @relation("ProductUpdatedBy", fields: [updatedBy], references: [userId])
  stockMovements    StockMovement[]
  stock             Stock?

  @@index([barcode], map: "idx_products_barcode")
  @@index([category])
  @@index([productCode])
  @@index([status])
  @@map("products")
}

model Stock {
  stockId      Int       @id @default(autoincrement()) @map("stock_id")
  productId    Int       @unique @map("product_id")
  quantity     Int       @default(0)
  stockVersion Int       @default(1) @map("stock_version")
  lastSyncTime DateTime? @map("last_sync_time")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  product      Product   @relation(fields: [productId], references: [productId])

  @@index([stockVersion])
  @@map("stocks")
}

model StockMovement {
  movementId   Int      @id @default(autoincrement()) @map("movement_id")
  productId    Int      @map("product_id")
  movementType String   @map("movement_type") @db.VarChar(20)
  quantity     Int
  cost         Decimal? @db.Decimal(10, 2)
  price        Decimal? @db.Decimal(10, 2)
  supplier     String?  @db.VarChar(200)
  reason       String?
  orderId      Int?     @map("order_id")
  shiftId      Int?     @map("shift_id")
  createdBy    Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  creator      User     @relation(fields: [createdBy], references: [userId])
  order        Order?   @relation(fields: [orderId], references: [orderId])
  product      Product  @relation(fields: [productId], references: [productId])
  shift        Shift?   @relation(fields: [shiftId], references: [shiftId])

  @@index([createdAt])
  @@index([movementType])
  @@index([orderId])
  @@index([productId])
  @@index([shiftId])
  @@map("stock_movements")
}

model Order {
  orderId        Int             @id @default(autoincrement()) @map("order_id")
  orderUuid      String          @unique @map("order_uuid") @db.Uuid
  receiptNumber  String          @unique @map("receipt_number") @db.VarChar(50)
  shiftId        Int             @map("shift_id")
  sellerId       Int             @map("seller_id")
  orderDate      DateTime        @default(now()) @map("order_date")
  totalAmount    Decimal         @map("total_amount") @db.Decimal(10, 2)
  discountAmount Decimal         @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount      Decimal         @default(0) @map("tax_amount") @db.Decimal(10, 2)
  serviceFee     Decimal         @default(0) @map("service_fee") @db.Decimal(10, 2)
  paymentMethod  String          @default("CASH") @map("payment_method") @db.VarChar(20)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  orderItems     OrderItem[]
  seller         User            @relation(fields: [sellerId], references: [userId])
  shift          Shift           @relation(fields: [shiftId], references: [shiftId])
  stockMovements StockMovement[]

  @@index([createdAt])
  @@index([orderDate])
  @@index([orderUuid])
  @@index([receiptNumber])
  @@index([sellerId])
  @@index([shiftId])
  @@map("orders")
}

model OrderItem {
  orderItemId    Int      @id @default(autoincrement()) @map("order_item_id")
  orderId        Int      @map("order_id")
  productId      Int      @map("product_id")
  productName    String   @map("product_name") @db.VarChar(200)
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  order          Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [productId])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Shift {
  shiftId          Int             @id @default(autoincrement()) @map("shift_id")
  sellerId         Int             @map("seller_id")
  shiftDate        DateTime        @map("shift_date") @db.Date
  startTime        DateTime        @map("start_time")
  endTime          DateTime?       @map("end_time")
  openingCash      Decimal         @map("opening_cash") @db.Decimal(10, 2)
  expectedCash     Decimal?        @map("expected_cash") @db.Decimal(10, 2)
  actualCash       Decimal?        @map("actual_cash") @db.Decimal(10, 2)
  shortAmount      Decimal?        @map("short_amount") @db.Decimal(10, 2)
  overAmount       Decimal?        @map("over_amount") @db.Decimal(10, 2)
  totalSalesCount  Int             @default(0) @map("total_sales_count")
  totalSalesAmount Decimal         @default(0) @map("total_sales_amount") @db.Decimal(10, 2)
  stockVersion     Int?            @map("stock_version")
  lastSyncTime     DateTime?       @map("last_sync_time")
  reportSentStatus String          @default("PENDING") @map("report_sent_status") @db.VarChar(20)
  closeMode        String          @default("NORMAL") @map("close_mode") @db.VarChar(20)
  forceCloseReason String?         @map("force_close_reason")
  status           String          @default("CLOSED") @db.VarChar(20)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")
  orders           Order[]
  seller           User            @relation(fields: [sellerId], references: [userId])
  stockMovements   StockMovement[]

  @@index([reportSentStatus])
  @@index([sellerId])
  @@index([shiftDate])
  @@index([status])
  @@map("shifts")
}

model DeviceBinding {
  bindingId  Int       @id @default(autoincrement()) @map("binding_id")
  userId     Int       @map("user_id")
  deviceId   String    @map("device_id") @db.VarChar(255)
  deviceName String?   @map("device_name") @db.VarChar(200)
  status     String    @db.VarChar(20)
  approvedBy Int?      @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  approver   User?     @relation("DeviceBindingApprovedBy", fields: [approvedBy], references: [userId])
  user       User      @relation(fields: [userId], references: [userId])

  @@index([deviceId])
  @@index([status])
  @@index([userId])
  @@map("device_bindings")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model AppSetting {
  settingId            Int      @id @default(autoincrement()) @map("setting_id")
  autoBackup           Boolean  @unique @default(true) @map("auto_backup")
  backupFrequency      String   @default("daily") @map("backup_frequency") @db.VarChar(20)
  deviceBindingEnabled Boolean  @default(false) @map("device_binding_enabled")
  stockSyncPolicy      String   @default("allow_with_cached") @map("stock_sync_policy") @db.VarChar(50)
  updatedBy            Int      @map("updated_by")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updater              User     @relation(fields: [updatedBy], references: [userId])

  @@map("app_settings")
}

model TelegramConfig {
  configId       Int       @id @default(autoincrement()) @map("config_id")
  botToken       String    @map("bot_token")
  groupChatId    String    @map("group_chat_id") @db.VarChar(255)
  isActive       Boolean   @unique @default(true) @map("is_active")
  lastTestTime   DateTime? @map("last_test_time")
  lastTestStatus String?   @map("last_test_status") @db.VarChar(20)
  createdBy      Int       @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedBy      Int       @map("updated_by")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  creator        User      @relation("TelegramConfigCreatedBy", fields: [createdBy], references: [userId])
  updater        User      @relation("TelegramConfigUpdatedBy", fields: [updatedBy], references: [userId])

  @@map("telegram_config")
}

model TelegramAdminLinks {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  telegramUserId BigInt    @unique @map("telegram_user_id")
  chatId         BigInt    @map("chat_id")
  status         String    @default("ACTIVE") @db.VarChar(10)
  linkedAt       DateTime  @default(now()) @map("linked_at")
  revokedAt      DateTime? @map("revoked_at")
  lastSeenAt     DateTime? @map("last_seen_at")
  user           User      @relation(fields: [userId], references: [userId])

  @@index([userId], map: "idx_telegram_admin_links_user")
  @@map("telegram_admin_links")
}

model TelegramAdminMessages {
  id             Int      @id @default(autoincrement())
  telegramUserId BigInt   @map("telegram_user_id")
  command        String   @db.Text
  requestId      String?  @map("request_id") @db.Uuid
  status         String   @default("SENT") @db.VarChar(10)
  messageId      BigInt?  @map("message_id")
  errorMessage   String?  @map("error_message") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([telegramUserId], map: "idx_telegram_admin_messages_user")
  @@index([requestId], map: "idx_telegram_admin_messages_request")
  @@map("telegram_admin_messages")
}

model AuditLog {
  logId      Int      @id @default(autoincrement()) @map("log_id")
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   Int?     @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [userId])

  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}
