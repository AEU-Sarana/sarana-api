# Database Timezone Configuration
# Set these in your .env file to configure PostgreSQL and system timezone

# PostgreSQL database timezone (IANA timezone format)
# Examples: UTC, Asia/Bangkok, America/New_York, Europe/London
DB_TIMEZONE=UTC

# System timezone for containers
# Examples: UTC, Asia/Bangkok, America/New_York, Europe/London
SYSTEM_TIMEZONE=UTC

# Common timezone options for your region:
# Asia:
#   - Asia/Bangkok (Thailand)
#   - Asia/Ho_Chi_Minh (Vietnam)
#   - Asia/Phnom_Penh (Cambodia)
#   - Asia/Singapore
#   - Asia/Kolkata (India)
#   - Asia/Jakarta (Indonesia)
#   - Asia/Manila (Philippines)
#   - Asia/Tokyo (Japan)
#   - Asia/Shanghai (China)

# Americas:
#   - America/New_York (Eastern)
#   - America/Chicago (Central)
#   - America/Denver (Mountain)
#   - America/Los_Angeles (Pacific)
#   - America/Toronto (Canada)

# Europe:
#   - Europe/London (GMT)
#   - Europe/Paris (CET)
#   - Europe/Berlin (CET)
#   - Europe/Moscow (MSK)
#   - Europe/Istanbul (EET)

# Africa/Middle East:
#   - Africa/Cairo (EET)
#   - Asia/Dubai (GST)
#   - Africa/Nairobi (EAT)
